		"body": [
			"from abc import ABC, abstractmethod",
			"",
			"class ${1:Mediator}(ABC):",
			"    @abstractmethod",
			"    def notify(self, sender: ${2:Colleague}, event: str) -> None: ...",
			"",
			"class ${2:Colleague}(ABC):",
			"    def __init__(self) -> None:",
			"        self._mediator: ${1:Mediator} | None = None",
			"",
			"    def set_mediator(self, mediator: ${1:Mediator}) -> None:",
			"        self._mediator = mediator",
			"",
			"    @abstractmethod",
			"    def send(self, event: str) -> None: ...",
			"",
			"class Concrete${1:Mediator}(${1:Mediator}):",
			"    def __init__(self) -> None:",
			"        self._colleagues: list[${2:Colleague}] = []",
			"",
			"    def register(self, colleague: ${2:Colleague}) -> None:",
			"        colleague.set_mediator(self)",
			"        self._colleagues.append(colleague)",
			"",
			"    def notify(self, sender: ${2:Colleague}, event: str) -> None:",
			"        for c in self._colleagues:",
			"            if c is not sender:",
			"                c.send(event)",
			"",
			"class Concrete${2:Colleague}(${2:Colleague}):",
			"    def send(self, event: str) -> None:",
			"        if self._mediator is not None:",
			"            self._mediator.notify(self, event)",
			"$0"
		],
		"description": "GoF Mediator \u2014 central coordinator for colleagues"
	},
