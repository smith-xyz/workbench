	"DP Behavioral: Iterator": {
		"prefix": "dp-behavioral-iterator",
		"body": [
			"from abc import ABC, abstractmethod",
			"",
			"class ${1:Iterator}(ABC):",
			"    @abstractmethod",
			"    def __iter__(self) -> ${1:Iterator}: ...",
			"",
			"    @abstractmethod",
			"    def __next__(self) -> int: ...",
			"",
			"class ${2:Aggregate}:",
			"    def __init__(self, items: list[int]) -> None:",
			"        self._items = items",
			"",
			"    def create_iterator(self) -> ${1:Iterator}:",
			"        return Concrete${1:Iterator}(self._items)",
			"",
			"class Concrete${1:Iterator}(${1:Iterator}):",
			"    def __init__(self, items: list[int]) -> None:",
			"        self._items = items",
			"        self._index = 0",
			"",
			"    def __iter__(self) -> Concrete${1:Iterator}:",
			"        return self",
			"",
			"    def __next__(self) -> int:",
			"        if self._index >= len(self._items):",
			"            raise StopIteration",
			"        value = self._items[self._index]",
			"        self._index += 1",
			"        return value",
			"$0"
		],
		"description": "GoF Iterator \u2014 aggregate + iterator ABC with __iter__/__next__"
	},
	"DP Behavioral: Mediator": {
