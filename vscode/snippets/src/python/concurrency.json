			"async def ${1:stream_items}() -> AsyncIterator[${2:Item}]:",
			"    for i in range(${3:100}):",
			"        yield ${2:Item}(id=i)",
			"",
			"async def ${4:consume_stream}() -> None:",
			"    async for item in ${1:stream_items}():",
			"        await ${5:process_item}(item)",
			"$0"
		],
		"description": "Async generator stream with async-for consumer loop"
	},
	"Concurrency: Semaphore": {
		"prefix": "cc-semaphore",
		"body": [
			"async def ${1:run_with_semaphore}(semaphore: asyncio.Semaphore) -> None:",
			"    async with semaphore:",
			"        await ${2:limited_work}()",
			"",
			"async def ${3:main}() -> None:",
			"    semaphore = asyncio.Semaphore(${4:5})",
			"    await asyncio.gather(*[${1:run_with_semaphore}(semaphore) for _ in range(${5:20})])",
			"$0"
		],
		"description": "Counting semaphore limiting concurrent asyncio tasks"
	}
}
