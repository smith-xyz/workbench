	"Data Structure: Stack": {
		"prefix": "ds-stack",
		"body": [
			"from typing import Generic, TypeVar",
			"",
			"T = TypeVar(\"T\")",
			"",
			"class ${1:Stack}(Generic[T]):",
			"    def __init__(self) -> None:",
			"        self._items: list[T] = []",
			"",
			"    def push(self, item: T) -> None:",
			"        self._items.append(item)",
			"",
			"    def pop(self) -> T | None:",
			"        if not self._items:",
			"            return None",
			"        return self._items.pop()",
			"",
			"    def peek(self) -> T | None:",
			"        if not self._items:",
			"            return None",
			"        return self._items[-1]",
			"$0"
		],
		"description": "Generic stack with push, pop, and peek."
	},
	"Data Structure: Queue": {
		"prefix": "ds-queue",
		"body": [
			"from collections import deque",
			"from typing import Generic, TypeVar",
			"",
			"T = TypeVar(\"T\")",
			"",
			"class ${1:Queue}(Generic[T]):",
			"    def __init__(self) -> None:",
			"        self._items: deque[T] = deque()",
			"",
			"    def enqueue(self, item: T) -> None:",
			"        self._items.append(item)",
			"",
			"    def dequeue(self) -> T | None:",
			"        if not self._items:",
			"            return None",
			"        return self._items.popleft()",
			"$0"
		],
		"description": "Generic FIFO queue using collections.deque."
	},
	"Data Structure: Priority Queue": {
		"prefix": "ds-priority-queue",
		"body": [
			"import heapq",
			"from dataclasses import dataclass, field",
			"from typing import Generic, TypeVar",
			"",
			"T = TypeVar(\"T\")",
			"",
			"@dataclass(order=True)",
			"class _${1:PrioritizedItem}(Generic[T]):",
			"    priority: int",
			"    item: T = field(compare=False)",
			"",
			"class ${2:PriorityQueue}(Generic[T]):",
			"    def __init__(self) -> None:",
			"        self._heap: list[_${1:PrioritizedItem}[T]] = []",
			"",
			"    def enqueue(self, item: T, priority: int) -> None:",
			"        heapq.heappush(self._heap, _${1:PrioritizedItem}(priority, item))",
			"",
			"    def dequeue(self) -> T | None:",
			"        if not self._heap:",
			"            return None",
			"        return heapq.heappop(self._heap).item",
			"$0"
		],
		"description": "Min-heap priority queue using heapq."
	},
	"Data Structure: Linked List": {
		"prefix": "ds-linked-list",
		"body": [
			"from dataclasses import dataclass",
			"from typing import Callable, Generic, TypeVar",
			"",
			"T = TypeVar(\"T\")",
			"",
			"@dataclass",
			"class _${1:Node}(Generic[T]):",
			"    val: T",
			"    next: \"_${1:Node}[T] | None\" = None",
			"",
			"class ${2:LinkedList}(Generic[T]):",
			"    def __init__(self) -> None:",
			"        self.head: _${1:Node}[T] | None = None",
			"",
			"    def insert(self, val: T) -> None:",
			"        self.head = _${1:Node}(val, self.head)",
			"",
			"    def delete(self, val: T) -> bool:",
			"        prev, cur = None, self.head",
			"        while cur:",
			"            if cur.val == val:",
			"                if prev:",
			"                    prev.next = cur.next",
			"                else:",
			"                    self.head = cur.next",
			"                return True",
			"            prev, cur = cur, cur.next",
			"        return False",
			"",
			"    def traverse(self, fn: Callable[[T], None]) -> None:",
			"        cur = self.head",
			"        while cur:",
			"            fn(cur.val)",
			"            cur = cur.next",
			"$0"
		],
		"description": "Singly linked list with insert, delete, and traverse."
	},
	"Data Structure: LRU Cache": {
		"prefix": "ds-lru-cache",
		"body": [
			"from collections import OrderedDict",
			"from typing import Generic, TypeVar",
			"",
			"K = TypeVar(\"K\")",
			"V = TypeVar(\"V\")",
			"",
			"class ${1:LRUCache}(Generic[K, V]):",
			"    def __init__(self, capacity: int) -> None:",
			"        self.capacity = capacity",
			"        self.cache: OrderedDict[K, V] = OrderedDict()",
			"",
			"    def get(self, key: K) -> V | None:",
			"        if key not in self.cache:",
			"            return None",
			"        self.cache.move_to_end(key)",
			"        return self.cache[key]",
			"",
			"    def put(self, key: K, value: V) -> None:",
			"        if key in self.cache:",
			"            self.cache.move_to_end(key)",
			"        self.cache[key] = value",
			"        if len(self.cache) > self.capacity:",
			"            self.cache.popitem(last=False)",
			"$0"
		],
		"description": "LRU cache with OrderedDict capacity eviction."
	},
	"Data Structure: Ring Buffer": {
		"prefix": "ds-ring-buffer",
		"body": [
			"from typing import Generic, TypeVar",
			"",
			"T = TypeVar(\"T\")",
			"",
			"class ${1:RingBuffer}(Generic[T]):",
			"    def __init__(self, capacity: int) -> None:",
			"        self._buf: list[T | None] = [None] * capacity",
			"        self._head = 0",
			"        self._tail = 0",
			"        self._size = 0",
			"        self._capacity = capacity",
			"",
			"    def write(self, item: T) -> bool:",
			"        if self._size == self._capacity:",
			"            return False",
			"        self._buf[self._tail] = item",
			"        self._tail = (self._tail + 1) % self._capacity",
			"        self._size += 1",
			"        return True",
			"",
			"    def read(self) -> T | None:",
			"        if self._size == 0:",
			"            return None",
			"        item = self._buf[self._head]",
			"        self._head = (self._head + 1) % self._capacity",
			"        self._size -= 1",
			"        return item",
			"$0"
		],
		"description": "Fixed-size circular buffer with read and write."
	},
	"Data Structure: Trie": {
		"prefix": "ds-trie",
		"body": [
			"class _${1:TrieNode}:",
			"    def __init__(self) -> None:",
			"        self.children: dict[str, _${1:TrieNode}] = {}",
			"        self.is_end = False",
			"",
			"class ${2:Trie}:",
			"    def __init__(self) -> None:",
			"        self.root = _${1:TrieNode}()",
			"",
			"    def insert(self, word: str) -> None:",
			"        node = self.root",
			"        for ch in word:",
			"            if ch not in node.children:",
			"                node.children[ch] = _${1:TrieNode}()",
			"            node = node.children[ch]",
			"        node.is_end = True",
			"",
			"    def search(self, word: str) -> bool:",
			"        node = self._find(word)",
			"        return node is not None and node.is_end",
			"",
			"    def starts_with(self, prefix: str) -> bool:",
			"        return self._find(prefix) is not None",
			"",
			"    def _find(self, s: str) -> _${1:TrieNode} | None:",
			"        node = self.root",
			"        for ch in s:",
			"            if ch not in node.children:",
			"                return None",
			"            node = node.children[ch]",
			"        return node",
			"$0"
		],
		"description": "Prefix trie with insert, search, and starts-with."
	},
	"Data Structure: Graph": {
		"prefix": "ds-graph",
		"body": [
			"from collections import deque",
			"from typing import Callable, Generic, TypeVar",
			"",
			"T = TypeVar(\"T\")",
			"",
			"class ${1:Graph}(Generic[T]):",
			"    def __init__(self) -> None:",
			"        self.adj: dict[T, list[T]] = {}",
			"",
			"    def add_edge(self, u: T, v: T) -> None:",
			"        self.adj.setdefault(u, []).append(v)",
			"",
			"    def bfs(self, start: T, visit: Callable[[T], None]) -> None:",
			"        seen = {start}",
			"        queue: deque[T] = deque([start])",
			"        while queue:",
			"            u = queue.popleft()",
			"            visit(u)",
			"            for v in self.adj.get(u, []):",
			"                if v not in seen:",
			"                    seen.add(v)",
			"                    queue.append(v)",
			"",
			"    def dfs(self, start: T, visit: Callable[[T], None]) -> None:",
			"        seen: set[T] = set()",
			"",
			"        def _dfs(u: T) -> None:",
			"            seen.add(u)",
			"            visit(u)",
			"            for v in self.adj.get(u, []):",
			"                if v not in seen:",
			"                    _dfs(v)",
			"",
			"        _dfs(start)",
			"$0"
		],
		"description": "Adjacency list graph with add-edge, BFS, and DFS."
	}
}
