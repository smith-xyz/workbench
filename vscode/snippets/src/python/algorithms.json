			"from collections import deque",
			"",
			"def bfs_${1:grid}(${1:grid}: list[list[int]], sr: int, sc: int, tr: int, tc: int) -> int:",
			"    rows, cols = len(${1:grid}), len(${1:grid}[0])",
			"    dirs = [(0, 1), (0, -1), (1, 0), (-1, 0)]",
			"    visited = set()",
			"    q = deque([(sr, sc, 0)])",
			"    visited.add((sr, sc))",
			"    while q:",
			"        r, c, dist = q.popleft()",
			"        if r == tr and c == tc:",
			"            return dist",
			"        for dr, dc in dirs:",
			"            nr, nc = r + dr, c + dc",
			"            if nr < 0 or nr >= rows or nc < 0 or nc >= cols:",
			"                continue",
			"            if (nr, nc) in visited or ${1:grid}[nr][nc] == ${2:block}:",
			"                continue",
			"            visited.add((nr, nc))",
			"            q.append((nr, nc, dist + 1))",
			"    $0",
			"    return -1"
		],
		"description": "BFS shortest path on a 2D grid with visited tracking"
