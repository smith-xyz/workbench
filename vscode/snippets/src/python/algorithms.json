	"Algorithm: Topological Sort": {
		"prefix": "al-topological-sort",
		"body": [
			"from collections import deque",
			"",
			"def topo_sort(n: int, edges: list[tuple[int, int]]) -> list[int]:",
			"    adj = [[] for _ in range(n)]",
			"    indeg = [0] * n",
			"    for u, v in edges:",
			"        adj[u].append(v)",
			"        indeg[v] += 1",
			"    q = deque(i for i in range(n) if indeg[i] == 0)",
			"    order: list[int] = []",
			"    while q:",
			"        u = q.popleft()",
			"        order.append(u)",
			"        for v in adj[u]:",
			"            indeg[v] -= 1",
			"            if indeg[v] == 0:",
			"                q.append(v)",
			"    $0",
			"    return order if len(order) == n else []"
		],
		"description": "Topological sort via Kahn's BFS-based algorithm"
	},
	"Algorithm: Union Find": {
		"prefix": "al-union-find",
		"body": [
			"class UnionFind:",
			"    def __init__(self, n: int) -> None:",
			"        self.parent = list(range(n))",
			"        self.rank = [0] * n",
			"",
			"    def find(self, x: int) -> int:",
			"        if self.parent[x] != x:",
			"            self.parent[x] = self.find(self.parent[x])",
			"        return self.parent[x]",
			"",
			"    def union(self, a: int, b: int) -> bool:",
			"        ra, rb = self.find(a), self.find(b)",
			"        if ra == rb:",
			"            return False",
			"        if self.rank[ra] < self.rank[rb]:",
			"            ra, rb = rb, ra",
			"        self.parent[rb] = ra",
			"        if self.rank[ra] == self.rank[rb]:",
			"            self.rank[ra] += 1",
			"        return True",
			"",
			"uf = UnionFind(${1:n})",
			"$0"
		],
		"description": "Disjoint set union with path compression and union by rank"
	},
