			"        this._state = memento.state;",
			"    }",
			"}",
			"",
			"class ${3:Caretaker} {",
			"    private history: ${1:Memento}[] = [];",
			"",
			"    push(memento: ${1:Memento}): void {",
			"        this.history.push(memento);",
			"    }",
			"",
			"    pop(): ${1:Memento} | undefined {",
			"        return this.history.pop();",
			"    }",
			"}",
			"",
			"$0"
		],
		"description": "GoF Memento pattern"
	},
	"DP Behavioral: Observer": {
		"prefix": "dp-behavioral-observer",
		"body": [
			"interface ${1:Observer}<T> {",
			"    update(data: T): void;",
			"}",
			"",
			"interface ${2:Subject}<T> {",
			"    attach(observer: ${1:Observer}<T>): void;",
			"    detach(observer: ${1:Observer}<T>): void;",
			"    notify(data: T): void;",
			"}",
			"",
			"class ${3:ConcreteSubject}<T> implements ${2:Subject}<T> {",
			"    private observers = new Set<${1:Observer}<T>>();",
			"",
			"    attach(observer: ${1:Observer}<T>): void {",
			"        this.observers.add(observer);",
			"    }",
			"",
			"    detach(observer: ${1:Observer}<T>): void {",
			"        this.observers.delete(observer);",
			"    }",
			"",
			"    notify(data: T): void {",
			"        for (const o of this.observers) o.update(data);",
			"    }",
			"}",
			"",
			"class ${4:ConcreteObserver}<T> implements ${1:Observer}<T> {",
			"    constructor(readonly name: string) {}",
			"",
			"    update(_data: T): void {}",
			"}",
			"",
			"$0"
		],
		"description": "GoF Observer pattern"
	},
