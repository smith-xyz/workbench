{
	"DP Creational: Abstract Factory": {
		"prefix": "dp-creational-abstract-factory",
		"body": [
			"interface ${1:ProductA} {",
			"    name: string;",
			"}",
			"",
			"interface ${2:ProductB} {",
			"    label: string;",
			"}",
			"",
			"interface ${3:AbstractFactory} {",
			"    createA(): ${1:ProductA};",
			"    createB(): ${2:ProductB};",
			"}",
			"",
			"class ${4:ConcreteProductA} implements ${1:ProductA} {",
			"    readonly name = 'A';",
			"}",
			"",
			"class ${5:ConcreteProductB} implements ${2:ProductB} {",
			"    readonly label = 'B';",
			"}",
			"",
			"class ${6:ConcreteFactory} implements ${3:AbstractFactory} {",
			"    createA(): ${1:ProductA} {",
			"        return new ${4:ConcreteProductA}();",
			"    }",
			"",
			"    createB(): ${2:ProductB} {",
			"        return new ${5:ConcreteProductB}();",
			"    }",
			"}",
			"",
			"$0"
		],
		"description": "GoF Abstract Factory pattern"
	},
	"DP Creational: Builder": {
		"prefix": "dp-creational-builder",
		"body": [
			"interface ${1:Product} {",
			"    parts: string[];",
			"}",
			"",
			"interface ${2:Builder} {",
			"    reset(): void;",
			"    buildPart(part: string): this;",
			"    getResult(): ${1:Product};",
			"}",
			"",
			"class ${3:ProductImpl} implements ${1:Product} {",
			"    parts: string[] = [];",
			"}",
			"",
			"class ${4:BuilderImpl} implements ${2:Builder} {",
			"    private product = new ${3:ProductImpl}();",
			"",
			"    reset(): void {",
			"        this.product = new ${3:ProductImpl}();",
			"    }",
			"",
			"    buildPart(part: string): this {",
			"        this.product.parts.push(part);",
			"        return this;",
			"    }",
			"",
			"    getResult(): ${1:Product} {",
			"        return this.product;",
			"    }",
			"}",
			"",
			"class ${5:Director} {",
			"    constructor(private builder: ${2:Builder}) {}",
			"",
			"    construct(): ${1:Product} {",
			"        return this.builder.reset().buildPart('part1').buildPart('part2').getResult();",
			"    }",
			"}",
			"",
			"$0"
		],
		"description": "GoF Builder pattern"
	},
	"DP Creational: Prototype": {
