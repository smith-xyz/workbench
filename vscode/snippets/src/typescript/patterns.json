			"        return new ${2:ConcretePrototype}(this.field, this.nested?.clone());",
			"    }",
			"}",
			"",
			"const original = new ${2:ConcretePrototype}('value');",
			"const copy = original.clone();",
			"",
			"$0"
		],
		"description": "GoF Prototype pattern"
	},
