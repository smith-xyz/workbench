	"DP Structural: Flyweight": {
		"prefix": "dp-structural-flyweight",
		"body": [
			"interface ${1:Flyweight} {",
			"    render(extrinsic: string): string;",
			"}",
			"",
			"class ${2:ConcreteFlyweight} implements ${1:Flyweight} {",
			"    constructor(readonly intrinsic: string) {}",
			"",
			"    render(extrinsic: string): string {",
			"        return \\`\\${this.intrinsic}:\\${extrinsic}\\`;",
			"    }",
			"}",
			"",
			"class ${3:FlyweightFactory} {",
			"    private pool = new Map<string, ${1:Flyweight}>();",
			"",
			"    get(key: string): ${1:Flyweight} {",
			"        let fw = this.pool.get(key);",
			"        if (!fw) {",
			"            fw = new ${2:ConcreteFlyweight}(key);",
			"            this.pool.set(key, fw);",
			"        }",
			"        return fw;",
			"    }",
			"}",
			"",
			"$0"
		],
		"description": "GoF Flyweight pattern"
	},
	"DP Structural: Proxy": {
		"prefix": "dp-structural-proxy",
		"body": [
			"interface ${1:Subject} {",
			"    request(): Promise<string>;",
			"}",
			"",
			"class ${2:RealSubject} implements ${1:Subject} {",
			"    async request(): Promise<string> {",
			"        return 'real';",
			"    }",
			"}",
			"",
			"class ${3:Proxy} implements ${1:Subject} {",
			"    private real?: ${2:RealSubject};",
			"",
			"    constructor(private cached?: string) {}",
			"",
			"    async request(): Promise<string> {",
			"        if (this.cached) return this.cached;",
			"        this.real ??= new ${2:RealSubject}();",
			"        this.cached = await this.real.request();",
			"        return this.cached;",
			"    }",
			"}",
			"",
			"$0"
		],
		"description": "GoF Proxy pattern"
	},
	"DP Behavioral: Chain of Responsibility": {
		"prefix": "dp-behavioral-chain",
		"body": [
			"interface ${1:Handler}<T> {",
			"    setNext(next: ${1:Handler}<T>): ${1:Handler}<T>;",
			"    handle(request: T): T | null;",
			"}",
			"",
			"abstract class ${2:BaseHandler}<T> implements ${1:Handler}<T> {",
			"    private next?: ${1:Handler}<T>;",
			"",
			"    setNext(next: ${1:Handler}<T>): ${1:Handler}<T> {",
			"        this.next = next;",
			"        return next;",
			"    }",
			"",
			"    handle(request: T): T | null {",
			"        const result = this.process(request);",
			"        if (result !== null) return result;",
			"        return this.next?.handle(request) ?? null;",
			"    }",
			"",
			"    protected abstract process(request: T): T | null;",
			"}",
			"",
			"class ${3:ConcreteHandler} extends ${2:BaseHandler}<string> {",
			"    protected process(request: string): string | null {",
			"        return request.length > 0 ? request.toUpperCase() : null;",
			"    }",
			"}",
			"",
			"$0"
		],
		"description": "GoF Chain of Responsibility pattern"
	},
	"DP Behavioral: Command": {
		"prefix": "dp-behavioral-command",
		"body": [
			"interface ${1:Command} {",
			"    execute(): void;",
			"    undo(): void;",
			"}",
			"",
			"class ${2:Receiver} {",
			"    private state = '';",
			"",
			"    action(value: string): void {",
			"        this.state = value;",
			"    }",
			"",
			"    getState(): string {",
			"        return this.state;",
			"    }",
			"}",
			"",
			"class ${3:ConcreteCommand} implements ${1:Command} {",
			"    private previous = '';",
			"",
			"    constructor(",
			"        private receiver: ${2:Receiver},",
			"        private value: string,",
			"    ) {}",
			"",
			"    execute(): void {",
			"        this.previous = this.receiver.getState();",
			"        this.receiver.action(this.value);",
			"    }",
			"",
			"    undo(): void {",
			"        this.receiver.action(this.previous);",
			"    }",
			"}",
			"",
			"class ${4:Invoker} {",
			"    private history: ${1:Command}[] = [];",
			"",
			"    run(cmd: ${1:Command}): void {",
			"        cmd.execute();",
			"        this.history.push(cmd);",
			"    }",
			"",
			"    undoLast(): void {",
			"        this.history.pop()?.undo();",
			"    }",
			"}",
			"",
			"$0"
		],
		"description": "GoF Command pattern"
	},
	"DP Behavioral: Iterator": {
		"prefix": "dp-behavioral-iterator",
		"body": [
			"interface ${1:Iterator}<T> {",
			"    next(): IteratorResult<T>;",
			"}",
			"",
			"interface ${2:IterableCollection}<T> {",
			"    createIterator(): ${1:Iterator}<T>;",
			"}",
			"",
			"class ${3:ConcreteIterator}<T> implements ${1:Iterator}<T> {",
			"    private index = 0;",
			"",
			"    constructor(private items: readonly T[]) {}",
			"",
			"    next(): IteratorResult<T> {",
			"        if (this.index >= this.items.length) {",
			"            return { value: undefined, done: true };",
			"        }",
			"        return { value: this.items[this.index++], done: false };",
			"    }",
			"}",
			"",
			"class ${4:ConcreteCollection}<T> implements ${2:IterableCollection}<T> {",
			"    constructor(private items: T[] = []) {}",
			"",
			"    add(item: T): void {",
			"        this.items.push(item);",
			"    }",
			"",
			"    createIterator(): ${1:Iterator}<T> {",
			"        return new ${3:ConcreteIterator}(this.items);",
			"    }",
			"}",
			"",
			"$0"
		],
		"description": "GoF Iterator pattern"
	},
	"DP Behavioral: Mediator": {
		"prefix": "dp-behavioral-mediator",
		"body": [
			"interface ${1:Mediator} {",
			"    notify(sender: ${2:Colleague}, event: string, payload?: unknown): void;",
			"}",
			"",
			"interface ${2:Colleague} {",
			"    setMediator(mediator: ${1:Mediator}): void;",
			"    receive(event: string, payload?: unknown): void;",
			"}",
			"",
			"class ${3:ConcreteMediator} implements ${1:Mediator} {",
			"    private colleagues = new Set<${2:Colleague}>();",
			"",
			"    register(colleague: ${2:Colleague}): void {",
			"        colleague.setMediator(this);",
			"        this.colleagues.add(colleague);",
			"    }",
			"",
			"    notify(sender: ${2:Colleague}, event: string, payload?: unknown): void {",
			"        for (const c of this.colleagues) {",
			"            if (c !== sender) c.receive(event, payload);",
			"        }",
			"    }",
			"}",
			"",
			"class ${4:ConcreteColleague} implements ${2:Colleague} {",
			"    private mediator?: ${1:Mediator};",
			"",
			"    setMediator(mediator: ${1:Mediator}): void {",
			"        this.mediator = mediator;",
			"    }",
			"",
			"    receive(_event: string, _payload?: unknown): void {}",
			"",
			"    send(event: string, payload?: unknown): void {",
			"        this.mediator?.notify(this, event, payload);",
			"    }",
			"}",
			"",
			"$0"
		],
		"description": "GoF Mediator pattern"
	},
	"DP Behavioral: Memento": {
		"prefix": "dp-behavioral-memento",
		"body": [
			"interface ${1:Memento} {",
			"    readonly state: string;",
			"}",
			"",
			"class ${2:Originator} {",
