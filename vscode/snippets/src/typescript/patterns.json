	"DP Behavioral: Visitor": {
		"prefix": "dp-behavioral-visitor",
		"body": [
			"interface ${1:Visitor} {",
			"    visitA(element: ${2:ElementA}): void;",
			"    visitB(element: ${3:ElementB}): void;",
			"}",
			"",
			"interface ${4:Element} {",
			"    accept(visitor: ${1:Visitor}): void;",
			"}",
			"",
			"class ${2:ElementA} implements ${4:Element} {",
			"    constructor(readonly value: string) {}",
			"",
			"    accept(visitor: ${1:Visitor}): void {",
			"        visitor.visitA(this);",
			"    }",
			"}",
			"",
			"class ${3:ElementB} implements ${4:Element} {",
			"    constructor(readonly count: number) {}",
			"",
			"    accept(visitor: ${1:Visitor}): void {",
			"        visitor.visitB(this);",
			"    }",
			"}",
			"",
			"class ${5:ConcreteVisitor} implements ${1:Visitor} {",
