	"Algorithm: Sliding Window": {
		"prefix": "al-sliding-window",
		"body": [
			"function slidingWindow(${1:nums}: number[], k: number): number {",
			"\tlet left = 0, result = 0, window = 0;",
			"\tfor (let right = 0; right < ${1:nums}.length; right++) {",
			"\t\twindow += ${1:nums}[right];",
			"\t\tif (right - left + 1 > k) {",
			"\t\t\twindow -= ${1:nums}[left];",
			"\t\t\tleft++;",
			"\t\t}",
			"\t\tif (right - left + 1 === k) {",
			"\t\t\t$0",
			"\t\t\tresult = Math.max(result, window);",
			"\t\t}",
			"\t}",
			"\treturn result;",
			"}"
