{
	"Algorithm: BFS Grid": {
		"prefix": "al-bfs-grid",
		"body": [
			"function bfs${1:Grid}(${1:grid}: number[][], sr: number, sc: number, tr: number, tc: number): number {",
			"\tconst rows = ${1:grid}.length;",
			"\tconst cols = ${1:grid}[0].length;",
			"\tconst dirs = [[0, 1], [0, -1], [1, 0], [-1, 0]];",
			"\tconst visited = new Set<string>();",
			"\tconst q: [number, number, number][] = [[sr, sc, 0]];",
			"\tvisited.add(`$${sr},$${sc}`);",
			"\twhile (q.length > 0) {",
			"\t\tconst [r, c, dist] = q.shift()!;",
			"\t\tif (r === tr && c === tc) return dist;",
			"\t\tfor (const [dr, dc] of dirs) {",
			"\t\t\tconst nr = r + dr, nc = c + dc;",
			"\t\t\tif (nr < 0 || nr >= rows || nc < 0 || nc >= cols) continue;",
			"\t\t\tconst key = `$${nr},$${nc}`;",
			"\t\t\tif (visited.has(key) || ${1:grid}[nr][nc] === ${2:block}) continue;",
			"\t\t\tvisited.add(key);",
			"\t\t\tq.push([nr, nc, dist + 1]);",
			"\t\t}",
			"\t}",
			"\t$0",
			"\treturn -1;",
			"}"
		],
		"description": "BFS shortest path on a 2D grid with visited tracking"
	},
