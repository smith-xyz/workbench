			"function floodFill(${1:grid}: number[][], r: number, c: number, ${2:old}: number, ${3:new}: number): void {",
			"\tconst rows = ${1:grid}.length, cols = ${1:grid}[0].length;",
			"\tif (r < 0 || r >= rows || c < 0 || c >= cols || ${1:grid}[r][c] !== ${2:old}) return;",
			"\t${1:grid}[r][c] = ${3:new};",
			"\t$0",
			"\tfloodFill(${1:grid}, r + 1, c, ${2:old}, ${3:new});",
			"\tfloodFill(${1:grid}, r - 1, c, ${2:old}, ${3:new});",
			"\tfloodFill(${1:grid}, r, c + 1, ${2:old}, ${3:new});",
			"\tfloodFill(${1:grid}, r, c - 1, ${2:old}, ${3:new});",
