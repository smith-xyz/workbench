	"Algorithm: Memoize": {
		"prefix": "al-memoize",
		"body": [
			"function memoize<A extends unknown[], R>(fn: (...args: A) => R): (...args: A) => R {",
			"\tconst cache = new Map<string, R>();",
			"\treturn (...args: A) => {",
			"\t\tconst key = JSON.stringify(args);",
			"\t\tif (cache.has(key)) return cache.get(key)!;",
			"\t\tconst result = fn(...args);",
			"\t\tcache.set(key, result);",
			"\t\treturn result;",
			"\t};",
			"}",
			"",
			"const solve = memoize((n: number): number => {",
			"\tif (n <= ${1:1}) return ${2:1};",
			"\treturn ${3:solve(n - 1) + solve(n - 2)};",
			"});",
			"",
			"const ans = solve(${4:n});",
			"$0"
		],
		"description": "Top-down DP with memoized recursion via Map cache"
