			"function binarySearch(${1:nums}: number[], ${2:target}: number): number {",
			"\tlet lo = 0, hi = ${1:nums}.length;",
			"\twhile (lo < hi) {",
			"\t\tconst mid = Math.floor((lo + hi) / 2);",
			"\t\tif (${1:nums}[mid] < ${2:target}) lo = mid + 1;",
			"\t\telse hi = mid;",
			"\t}",
			"\treturn lo;",
			"}",
			"",
			"const idx = binarySearch(${1:nums}, ${2:target});",
			"if (idx < ${1:nums}.length && ${1:nums}[idx] === ${2:target}) {",
