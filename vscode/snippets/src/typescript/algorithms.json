	"Algorithm: Topological Sort": {
		"prefix": "al-topological-sort",
		"body": [
			"function topoSort(n: number, edges: [number, number][]): number[] {",
			"\tconst adj: number[][] = Array.from({ length: n }, () => []);",
			"\tconst indeg = new Array(n).fill(0);",
			"\tfor (const [u, v] of edges) {",
			"\t\tadj[u].push(v);",
			"\t\tindeg[v]++;",
			"\t}",
			"\tconst q: number[] = [];",
			"\tfor (let i = 0; i < n; i++) if (indeg[i] === 0) q.push(i);",
			"\tconst order: number[] = [];",
			"\twhile (q.length > 0) {",
			"\t\tconst u = q.shift()!;",
			"\t\torder.push(u);",
			"\t\tfor (const v of adj[u]) {",
			"\t\t\tindeg[v]--;",
			"\t\t\tif (indeg[v] === 0) q.push(v);",
			"\t\t}",
			"\t}",
			"\t$0",
			"\treturn order.length === n ? order : [];",
			"}"
		],
		"description": "Topological sort via Kahn's BFS-based algorithm"
	},
	"Algorithm: Union Find": {
		"prefix": "al-union-find",
		"body": [
			"class UnionFind {",
			"\tparent: number[];",
			"\trank: number[];",
			"",
			"\tconstructor(n: number) {",
			"\t\tthis.parent = Array.from({ length: n }, (_, i) => i);",
			"\t\tthis.rank = new Array(n).fill(0);",
			"\t}",
			"",
			"\tfind(x: number): number {",
			"\t\tif (this.parent[x] !== x) this.parent[x] = this.find(this.parent[x]);",
			"\t\treturn this.parent[x];",
			"\t}",
			"",
			"\tunion(a: number, b: number): boolean {",
			"\t\tlet ra = this.find(a), rb = this.find(b);",
			"\t\tif (ra === rb) return false;",
			"\t\tif (this.rank[ra] < this.rank[rb]) [ra, rb] = [rb, ra];",
			"\t\tthis.parent[rb] = ra;",
			"\t\tif (this.rank[ra] === this.rank[rb]) this.rank[ra]++;",
			"\t\treturn true;",
			"\t}",
			"}",
			"",
			"const uf = new UnionFind(${1:n});",
			"$0"
		],
		"description": "Disjoint set union with path compression and union by rank"
