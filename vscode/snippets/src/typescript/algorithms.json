	"Algorithm: Two Pointer": {
		"prefix": "al-two-pointer",
		"body": [
			"function twoPointer(${1:nums}: number[], ${2:target}: number): [number, number] {",
			"\tlet left = 0, right = ${1:nums}.length - 1;",
			"\twhile (left < right) {",
			"\t\tconst sum = ${1:nums}[left] + ${1:nums}[right];",
			"\t\tif (sum === ${2:target}) return [left, right];",
			"\t\tif (sum < ${2:target}) left++;",
			"\t\telse right--;",
			"\t}",
			"\t$0",
			"\treturn [-1, -1];",
			"}"
		],
		"description": "Converging two pointers on a sorted array"
	},
	"Algorithm: Binary Search": {
		"prefix": "al-binary-search",
