{
	"Concurrency: Worker Pool": {
		"prefix": "cc-worker-pool",
		"body": [
			"class ${1:WorkerPool}<T, R> {",
			"    private readonly queue: Array<() => void> = [];",
			"    private active = 0;",
			"",
			"    constructor(",
			"        private readonly workerCount: number,",
			"        private readonly handler: (item: T) => Promise<R>,",
			"    ) {}",
			"",
			"    async submit(item: T): Promise<R> {",
			"        return new Promise<R>((resolve, reject) => {",
			"            const run = async () => {",
			"                this.active++;",
			"                try {",
			"                    resolve(await this.handler(item));",
			"                } catch (error) {",
			"                    reject(error);",
			"                } finally {",
			"                    this.active--;",
			"                    this.drain();",
			"                }",
			"            };",
			"            if (this.active < this.workerCount) {",
			"                void run();",
			"            } else {",
			"                this.queue.push(() => void run());",
			"            }",
			"        });",
			"    }",
			"",
			"    private drain(): void {",
			"        while (this.active < this.workerCount && this.queue.length > 0) {",
			"            const next = this.queue.shift();",
			"            if (next) next();",
			"        }",
			"    }",
			"}",
			"$0"
		],
		"description": "Fixed worker pool with queued submit and bounded concurrency"
	},
	"Concurrency: Mutex": {
		"prefix": "cc-mutex",
		"body": [
			"class ${1:AsyncMutex} {",
			"    private locked = false;",
			"    private readonly waiters: Array<() => void> = [];",
			"",
			"    async acquire(): Promise<() => void> {",
			"        while (this.locked) {",
			"            await new Promise<void>((resolve) => this.waiters.push(resolve));",
			"        }",
			"        this.locked = true;",
			"        return () => {",
			"            this.locked = false;",
			"            const next = this.waiters.shift();",
			"            if (next) next();",
			"        };",
			"    }",
			"}",
			"",
			"async function ${2:withLock}<T>(mutex: ${1:AsyncMutex}, fn: () => Promise<T>): Promise<T> {",
			"    const release = await mutex.acquire();",
			"    try {",
			"        return await fn();",
			"    } finally {",
			"        release();",
			"    }",
			"}",
			"$0"
		],
		"description": "Async mutex with acquire/release and withLock helper"
	},
	"Concurrency: Channel": {
		"prefix": "cc-channel",
		"body": [
			"class ${1:AsyncQueue}<T> {",
			"    private readonly items: T[] = [];",
			"    private readonly resolvers: Array<(value: T) => void> = [];",
			"",
			"    enqueue(item: T): void {",
			"        const resolve = this.resolvers.shift();",
			"        if (resolve) {",
			"            resolve(item);",
			"        } else {",
			"            this.items.push(item);",
			"        }",
			"    }",
			"",
			"    async dequeue(): Promise<T> {",
			"        const item = this.items.shift();",
			"        if (item !== undefined) return item;",
			"        return new Promise<T>((resolve) => this.resolvers.push(resolve));",
			"    }",
			"}",
			"",
			"async function ${2:runProducerConsumer}(): Promise<${3:number}[]> {",
			"    const jobs = new ${1:AsyncQueue}<${3:number}>();",
			"    const results = new ${1:AsyncQueue}<${3:number}>();",
			"",
			"    const producer = (async () => {",
			"        for (let i = 0; i < ${4:100}; i++) jobs.enqueue(i);",
			"    })();",
			"",
			"    const consumer = (async () => {",
			"        for (let i = 0; i < ${4:100}; i++) {",
			"            const job = await jobs.dequeue();",
			"            results.enqueue(job * 2);",
			"        }",
			"    })();",
			"",
			"    await Promise.all([producer, consumer]);",
			"    const collected: ${3:number}[] = [];",
			"    for (let i = 0; i < ${4:100}; i++) collected.push(await results.dequeue());",
			"    return collected;",
			"}",
			"$0"
		],
		"description": "Producer/consumer pattern via promise-backed async queue"
	},
	"Concurrency: Rate Limiter": {
		"prefix": "cc-rate-limiter",
		"body": [
			"class ${1:TokenBucket} {",
			"    private tokens: number;",
			"    private readonly capacity: number;",
			"    private readonly refillMs: number;",
			"    private lastRefill = Date.now();",
			"",
			"    constructor(ratePerSec: number, capacity: number) {",
			"        this.capacity = capacity;",
			"        this.tokens = capacity;",
			"        this.refillMs = 1000 / ratePerSec;",
			"    }",
			"",
			"    private refill(): void {",
			"        const now = Date.now();",
			"        const elapsed = now - this.lastRefill;",
			"        this.lastRefill = now;",
			"        this.tokens = Math.min(this.capacity, this.tokens + elapsed / this.refillMs);",
			"    }",
			"",
			"    async acquire(): Promise<void> {",
			"        this.refill();",
			"        if (this.tokens < 1) {",
			"            await new Promise<void>((resolve) =>",
			"                setTimeout(resolve, (1 - this.tokens) * this.refillMs),",
			"            );",
			"            this.tokens = 0;",
			"        } else {",
			"            this.tokens -= 1;",
			"        }",
			"    }",
			"}",
			"$0"
		],
		"description": "Token-bucket rate limiter with timed refill"
	},
	"Concurrency: Fan-Out Fan-In": {
		"prefix": "cc-fan-out-fan-in",
		"body": [
			"async function ${1:fanOutFanIn}<T, R>(",
			"    items: T[],",
			"    concurrency: number,",
			"    worker: (item: T) => Promise<R>,",
			"): Promise<R[]> {",
			"    const results: R[] = new Array(items.length);",
			"    let index = 0;",
			"",
			"    async function runWorker(): Promise<void> {",
			"        while (true) {",
			"            const current = index++;",
			"            if (current >= items.length) return;",
			"            results[current] = await worker(items[current]);",
			"        }",
			"    }",
			"",
			"    await Promise.all(Array.from({ length: concurrency }, () => runWorker()));",
			"    return results;",
			"}",
			"$0"
		],
		"description": "Fan items to concurrent workers and collect ordered results"
	},
	"Concurrency: Context Cancel": {
		"prefix": "cc-context-cancel",
		"body": [
			"async function ${1:runWithCancel}(",
			"    signal: AbortSignal,",
			"    work: (signal: AbortSignal) => Promise<void>,",
			"): Promise<void> {",
			"    const controller = new AbortController();",
			"    signal.addEventListener('abort', () => controller.abort(), { once: true });",
			"",
			"    const task = work(controller.signal);",
			"    const cancel = new Promise<never>((_, reject) => {",
			"        controller.signal.addEventListener('abort', () => reject(new DOMException('Aborted', 'AbortError')), {",
			"            once: true,",
			"        });",
			"    });",
			"",
			"    await Promise.race([task, cancel]);",
			"}",
			"$0"
		],
		"description": "Cancellation propagation via AbortController and Promise.race"
	},
	"Concurrency: Async Stream": {
		"prefix": "cc-async-stream",
		"body": [
			"async function* ${1:streamItems}(): AsyncGenerator<${2:Item}, void, unknown> {",
			"    for (let i = 0; i < ${3:100}; i++) {",
			"        yield { id: i };",
			"    }",
			"}",
			"",
			"async function ${4:consumeStream}(): Promise<void> {",
			"    for await (const item of ${1:streamItems}()) {",
			"        await ${5:processItem}(item);",
			"    }",
			"}",
			"$0"
		],
		"description": "Async generator stream consumed with for-await-of"
	},
	"Concurrency: Semaphore": {
		"prefix": "cc-semaphore",
		"body": [
			"class ${1:Semaphore} {",
			"    private permits: number;",
			"    private readonly waiters: Array<() => void> = [];",
			"",
			"    constructor(permits: number) {",
			"        this.permits = permits;",
			"    }",
			"",
			"    async acquire(): Promise<() => void> {",
			"        if (this.permits > 0) {",
			"            this.permits -= 1;",
			"            return () => this.release();",
			"        }",
			"        await new Promise<void>((resolve) => this.waiters.push(resolve));",
			"        return () => this.release();",
			"    }",
			"",
			"    private release(): void {",
			"        const next = this.waiters.shift();",
			"        if (next) {",
			"            next();",
			"        } else {",
			"            this.permits += 1;",
			"        }",
			"    }",
			"}",
			"$0"
		],
		"description": "Counting semaphore limiting concurrent async operations"
	}
}
