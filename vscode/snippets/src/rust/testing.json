{
	"Testing: Table Driven": {
		"prefix": "tt-table-driven",
		"body": [
			"#[cfg(test)]",
			"mod tests {",
			"    use super::*;",
			"",
			"    #[test]",
			"    fn ${1:parse_duration}_cases() {",
			"        let cases = [",
			"            (\"5s\", Ok(std::time::Duration::from_secs(5))),",
			"            (\"2m\", Ok(std::time::Duration::from_secs(120))),",
			"            (\"bad\", Err(\"invalid duration\".into())),",
			"        ];",
			"",
			"        for (input, expected) in cases {",
			"            let result = ${1:parse_duration}(input);",
			"            match (result, expected) {",
			"                (Ok(got), Ok(want)) => assert_eq!(got, want, \"input: {input}\"),",
			"                (Err(_), Err(_)) => {}",
			"                (got, want) => panic!(\"input {input:?}: got {got:?}, want {want:?}\"),",
			"            }",
			"            $0",
			"        }",
			"    }",
			"}"
		],
		"description": "Table-driven test with a cases array and match assertions"
	},
	"Testing: Mock": {
		"prefix": "tt-mock",
		"body": [
			"pub trait ${1:Notifier} {",
			"    fn send(&mut self, message: &str) -> Result<(), String>;",
			"}",
			"",
			"#[cfg(test)]",
			"mod tests {",
			"    use super::*;",
			"",
			"    struct Mock${1:Notifier} {",
			"        messages: Vec<String>,",
			"    }",
			"",
			"    impl Mock${1:Notifier} {",
			"        fn new() -> Self {",
			"            Self { messages: Vec::new() }",
			"        }",
			"    }",
			"",
			"    impl ${1:Notifier} for Mock${1:Notifier} {",
			"        fn send(&mut self, message: &str) -> Result<(), String> {",
			"            self.messages.push(message.to_string());",
			"            Ok(())",
			"        }",
			"    }",
			"",
			"    #[test]",
			"    fn ${2:order_service}_sends_confirmation() {",
			"        let mut notifier = Mock${1:Notifier}::new();",
			"        let mut service = ${2:OrderService}::new(&mut notifier);",
			"",
			"        service.confirm_order(\"order-42\").unwrap();",
			"        assert_eq!(notifier.messages.len(), 1);",
			"        $0",
			"    }",
			"}"
		],
		"description": "Manual mock struct implementing a trait for unit tests"
	},
	"Testing: Fixture": {
		"prefix": "tt-fixture",
		"body": [
			"#[cfg(test)]",
			"mod tests {",
			"    use super::*;",
			"",
			"    struct ${1:UserRepository}Fixture {",
			"        repo: ${1:UserRepository},",
			"    }",
			"",
			"    impl ${1:UserRepository}Fixture {",
			"        fn new() -> Self {",
			"            let repo = ${1:UserRepository}::in_memory();",
			"            repo.migrate().expect(\"migrate\");",
			"            Self { repo }",
			"        }",
			"    }",
			"",
			"    impl Drop for ${1:UserRepository}Fixture {",
			"        fn drop(&mut self) {",
			"            self.repo.close();",
			"        }",
			"    }",
			"",
			"    #[test]",
			"    fn ${1:user_repository}_creates_user() {",
			"        let fixture = ${1:UserRepository}Fixture::new();",
			"        let user = fixture.repo.create(\"alice@example.com\").unwrap();",
			"        assert_eq!(user.email, \"alice@example.com\");",
			"        $0",
			"    }",
			"}"
		],
		"description": "Test fixture struct with setup constructor and Drop teardown"
	},
