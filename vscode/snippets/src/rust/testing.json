	"Testing: Benchmark": {
		"prefix": "tt-benchmark",
		"body": [
			"use criterion::{black_box, criterion_group, criterion_main, Criterion};",
			"",
			"fn bench_${1:encode_json}(c: &mut Criterion) {",
			"    let payload = serde_json::json!({",
			"        \"id\": \"session-9f3a\",",
			"        \"user\": \"alice\",",
			"        \"roles\": [\"admin\", \"editor\"]",
			"    });",
			"",
			"    c.bench_function(\"${1:encode_json}\", |b| {",
			"        b.iter(|| ${1:encode_json}(black_box(&payload)))",
			"    });",
			"    $0",
			"}",
			"",
			"criterion_group!(benches, bench_${1:encode_json});",
			"criterion_main!(benches);"
		],
		"description": "Criterion benchmark with black_box and criterion_group"
	},
	"Testing: HTTP Mock": {
		"prefix": "tt-http-mock",
		"body": [
			"#[cfg(test)]",
			"mod tests {",
			"    use super::*;",
			"    use mockito::Server;",
			"",
			"    #[test]",
			"    fn ${1:weather_client}_get_forecast() {",
			"        let mut server = Server::new();",
			"        let mock = server",
			"            .mock(\"GET\", \"/forecast\")",
			"            .with_status(200)",
			"            .with_header(\"content-type\", \"application/json\")",
			"            .with_body(r#\"{\"city\":\"Portland\",\"temp_c\":18}\"#)",
			"            .create();",
			"",
			"        let client = ${1:WeatherClient}::new(server.url());",
			"        let forecast = client.get_forecast(\"Portland\").unwrap();",
			"        mock.assert();",
			"        assert_eq!(forecast.temp_c, 18);",
			"        $0",
			"    }",
			"}"
		],
		"description": "mockito HTTP mock server for API client integration tests"
	},
