	"Data Structure: Priority Queue": {
		"prefix": "ds-priority-queue",
		"body": [
			"use std::cmp::Reverse;",
			"use std::collections::BinaryHeap;",
			"",
			"pub struct ${1:PriorityQueue}<T> {",
			"    heap: BinaryHeap<(Reverse<i32>, T)>,",
			"}",
			"",
			"impl<T> ${1:PriorityQueue}<T> {",
			"    pub fn new() -> Self {",
			"        Self { heap: BinaryHeap::new() }",
			"    }",
			"",
			"    pub fn enqueue(&mut self, item: T, priority: i32) {",
			"        self.heap.push((Reverse(priority), item));",
			"    }",
			"",
			"    pub fn dequeue(&mut self) -> Option<T> {",
			"        self.heap.pop().map(|(_, item)| item)",
			"    }",
			"}",
			"$0"
		],
		"description": "Min-heap priority queue using BinaryHeap."
