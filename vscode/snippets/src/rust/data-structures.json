	"Data Structure: Linked List": {
		"prefix": "ds-linked-list",
		"body": [
			"struct ${1:Node}<T> {",
			"    val: T,",
			"    next: Option<Box<${1:Node}<T>>>,",
			"}",
			"",
			"pub struct ${2:LinkedList}<T> {",
			"    head: Option<Box<${1:Node}<T>>>,",
			"}",
			"",
			"impl<T: PartialEq> ${2:LinkedList}<T> {",
			"    pub fn new() -> Self {",
			"        Self { head: None }",
			"    }",
			"",
			"    pub fn insert(&mut self, val: T) {",
			"        self.head = Some(Box::new(${1:Node} { val, next: self.head.take() }));",
			"    }",
			"",
			"    pub fn delete(&mut self, val: T) -> bool {",
			"        let mut cur = &mut self.head;",
			"        while let Some(node) = cur {",
			"            if node.val == val {",
			"                *cur = node.next.take();",
			"                return true;",
			"            }",
			"            cur = &mut node.next;",
			"        }",
			"        false",
			"    }",
			"",
			"    pub fn traverse<F: FnMut(&T)>(&self, mut f: F) {",
			"        let mut cur = self.head.as_ref();",
			"        while let Some(node) = cur {",
			"            f(&node.val);",
			"            cur = node.next.as_ref();",
			"        }",
			"    }",
			"}",
			"$0"
		],
		"description": "Singly linked list with insert, delete, and traverse."
	},
	"Data Structure: LRU Cache": {
		"prefix": "ds-lru-cache",
		"body": [
			"use std::collections::{HashMap, VecDeque};",
			"use std::hash::Hash;",
			"",
			"pub struct ${1:LRUCache}<K, V>",
			"where",
			"    K: Eq + Hash + Clone,",
			"{",
			"    capacity: usize,",
			"    map: HashMap<K, V>,",
			"    order: VecDeque<K>,",
			"}",
			"",
			"impl<K, V> ${1:LRUCache}<K, V>",
			"where",
			"    K: Eq + Hash + Clone,",
			"{",
			"    pub fn new(capacity: usize) -> Self {",
			"        Self {",
			"            capacity,",
			"            map: HashMap::new(),",
			"            order: VecDeque::new(),",
			"        }",
			"    }",
			"",
			"    fn touch(&mut self, key: &K) {",
			"        if let Some(pos) = self.order.iter().position(|k| k == key) {",
			"            let k = self.order.remove(pos).unwrap();",
			"            self.order.push_back(k);",
			"        }",
			"    }",
			"",
			"    pub fn get(&mut self, key: &K) -> Option<&V> {",
			"        if self.map.contains_key(key) {",
			"            self.touch(key);",
			"            self.map.get(key)",
			"        } else {",
			"            None",
			"        }",
			"    }",
			"",
			"    pub fn put(&mut self, key: K, value: V) {",
			"        if self.map.contains_key(&key) {",
			"            self.touch(&key);",
			"            self.map.insert(key, value);",
			"            return;",
			"        }",
			"        if self.order.len() >= self.capacity {",
			"            if let Some(old) = self.order.pop_front() {",
			"                self.map.remove(&old);",
			"            }",
			"        }",
			"        self.map.insert(key.clone(), value);",
			"        self.order.push_back(key);",
			"    }",
			"}",
			"$0"
		],
		"description": "LRU cache with HashMap and VecDeque eviction."
	},
	"Data Structure: Ring Buffer": {
		"prefix": "ds-ring-buffer",
		"body": [
			"pub struct ${1:RingBuffer}<T> {",
			"    buf: Vec<Option<T>>,",
			"    head: usize,",
			"    tail: usize,",
			"    size: usize,",
			"}",
			"",
			"impl<T> ${1:RingBuffer}<T> {",
			"    pub fn new(capacity: usize) -> Self {",
			"        let mut buf = Vec::with_capacity(capacity);",
			"        buf.resize_with(capacity, || None);",
			"        Self { buf, head: 0, tail: 0, size: 0 }",
			"    }",
			"",
			"    pub fn write(&mut self, item: T) -> bool {",
			"        if self.size == self.buf.len() {",
			"            return false;",
			"        }",
			"        self.buf[self.tail] = Some(item);",
			"        self.tail = (self.tail + 1) % self.buf.len();",
			"        self.size += 1;",
			"        true",
			"    }",
			"",
			"    pub fn read(&mut self) -> Option<T> {",
			"        if self.size == 0 {",
			"            return None;",
			"        }",
			"        let item = self.buf[self.head].take();",
			"        self.head = (self.head + 1) % self.buf.len();",
			"        self.size -= 1;",
			"        item",
			"    }",
			"}",
			"$0"
		],
		"description": "Fixed-size circular buffer with read and write."
	},
	"Data Structure: Trie": {
		"prefix": "ds-trie",
		"body": [
			"use std::collections::HashMap;",
			"",
			"struct ${1:TrieNode} {",
			"    children: HashMap<char, ${1:TrieNode}>,",
			"    is_end: bool,",
			"}",
			"",
			"impl ${1:TrieNode} {",
			"    fn new() -> Self {",
			"        Self {",
			"            children: HashMap::new(),",
			"            is_end: false,",
			"        }",
			"    }",
			"}",
			"",
			"pub struct ${2:Trie} {",
			"    root: ${1:TrieNode},",
			"}",
			"",
			"impl ${2:Trie} {",
			"    pub fn new() -> Self {",
			"        Self { root: ${1:TrieNode}::new() }",
			"    }",
			"",
			"    pub fn insert(&mut self, word: &str) {",
			"        let mut node = &mut self.root;",
			"        for ch in word.chars() {",
			"            node = node.children.entry(ch).or_insert_with(${1:TrieNode}::new);",
			"        }",
			"        node.is_end = true;",
			"    }",
			"",
			"    pub fn search(&self, word: &str) -> bool {",
			"        Self::find(&self.root, word).map_or(false, |n| n.is_end)",
			"    }",
			"",
			"    pub fn starts_with(&self, prefix: &str) -> bool {",
			"        Self::find(&self.root, prefix).is_some()",
			"    }",
			"",
			"    fn find<'a>(node: &'a ${1:TrieNode}, s: &str) -> Option<&'a ${1:TrieNode}> {",
			"        let mut node = node;",
			"        for ch in s.chars() {",
			"            node = node.children.get(&ch)?;",
			"        }",
			"        Some(node)",
			"    }",
			"}",
			"$0"
		],
		"description": "Prefix trie with insert, search, and starts-with."
	},
	"Data Structure: Graph": {
		"prefix": "ds-graph",
		"body": [
			"use std::collections::{HashMap, HashSet, VecDeque};",
			"use std::hash::Hash;",
			"",
			"pub struct ${1:Graph}<T: Eq + Hash + Clone> {",
			"    adj: HashMap<T, Vec<T>>,",
			"}",
			"",
			"impl<T: Eq + Hash + Clone> ${1:Graph}<T> {",
			"    pub fn new() -> Self {",
			"        Self { adj: HashMap::new() }",
			"    }",
			"",
			"    pub fn add_edge(&mut self, u: T, v: T) {",
			"        self.adj.entry(u).or_default().push(v);",
			"    }",
			"",
			"    pub fn bfs<F: FnMut(&T)>(&self, start: T, mut visit: F) {",
			"        let mut seen = HashSet::new();",
			"        let mut queue = VecDeque::new();",
			"        seen.insert(start.clone());",
			"        queue.push_back(start);",
			"        while let Some(u) = queue.pop_front() {",
			"            visit(&u);",
			"            if let Some(neighbors) = self.adj.get(&u) {",
			"                for v in neighbors {",
			"                    if seen.insert(v.clone()) {",
			"                        queue.push_back(v.clone());",
			"                    }",
			"                }",
			"            }",
			"        }",
			"    }",
			"",
			"    pub fn dfs<F: FnMut(&T)>(&self, start: T, mut visit: F) {",
			"        let mut seen = HashSet::new();",
			"        Self::dfs_inner(&self.adj, start, &mut seen, &mut visit);",
			"    }",
			"",
			"    fn dfs_inner<F: FnMut(&T)>(",
			"        adj: &HashMap<T, Vec<T>>,",
			"        u: T,",
			"        seen: &mut HashSet<T>,",
			"        visit: &mut F,",
			"    ) {",
			"        seen.insert(u.clone());",
			"        visit(&u);",
			"        if let Some(neighbors) = adj.get(&u) {",
			"            for v in neighbors {",
			"                if !seen.contains(v) {",
			"                    Self::dfs_inner(adj, v.clone(), seen, visit);",
			"                }",
			"            }",
			"        }",
			"    }",
			"}",
			"$0"
		],
		"description": "Adjacency list graph with add-edge, BFS, and DFS."
	}
}
