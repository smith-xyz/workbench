{
	"Concurrency: Worker Pool": {
		"prefix": "cc-worker-pool",
		"body": [
			"async fn ${1:run_worker_pool}(",
			"    jobs: tokio::sync::mpsc::Receiver<${2:Job}>,",
			"    worker_count: usize,",
			"    handler: impl Fn(${2:Job}) + Send + Sync + Copy + 'static,",
			") -> Vec<tokio::task::JoinHandle<()>> {",
			"    let jobs = Arc::new(tokio::sync::Mutex::new(jobs));",
			"",
			"    (0..worker_count)",
			"        .map(|_| {",
			"            let jobs = Arc::clone(&jobs);",
			"            tokio::spawn(async move {",
			"                loop {",
			"                    let job = {",
			"                        let mut receiver = jobs.lock().await;",
			"                        receiver.recv().await",
			"                    };",
			"                    match job {",
			"                        Some(job) => handler(job),",
			"                        None => break,",
			"                    }",
			"                }",
			"            })",
			"        })",
			"        .collect()",
			"}",
			"$0"
		],
		"description": "Tokio worker pool draining an mpsc job receiver"
	},
	"Concurrency: Mutex": {
		"prefix": "cc-mutex",
		"body": [
			"struct ${1:Counter} {",
			"    inner: Arc<Mutex<i64>>,",
			"}",
			"",
			"impl ${1:Counter} {",
			"    fn new() -> Self {",
			"        Self { inner: Arc::new(Mutex::new(0)) }",
			"    }",
			"",
			"    fn inc(&self) {",
			"        let mut guard = self.inner.lock().unwrap();",
			"        *guard += 1;",
			"    }",
			"",
			"    fn value(&self) -> i64 {",
			"        *self.inner.lock().unwrap()",
			"    }",
			"}",
			"$0"
		],
		"description": "Arc<Mutex<T>> guarding shared state across tasks"
	},
	"Concurrency: Channel": {
		"prefix": "cc-channel",
		"body": [
			"async fn ${1:run_producer_consumer}() -> Result<Vec<${2:i32}>, Box<dyn std::error::Error + Send + Sync>> {",
			"    let (job_tx, mut job_rx) = tokio::sync::mpsc::channel::<${2:i32}>(${3:10});",
			"    let (result_tx, mut result_rx) = tokio::sync::mpsc::channel::<${2:i32}>(${3:10});",
			"",
			"    let producer = tokio::spawn(async move {",
			"        for i in 0..${4:100} {",
			"            job_tx.send(i).await?;",
			"        }",
			"        Ok::<_, tokio::sync::mpsc::error::SendError<${2:i32}>>(())",
			"    });",
			"",
			"    let consumer = tokio::spawn(async move {",
			"        while let Some(job) = job_rx.recv().await {",
			"            result_tx.send(job * 2).await?;",
			"        }",
			"        Ok::<_, tokio::sync::mpsc::error::SendError<${2:i32}>>(())",
			"    });",
			"",
			"    let (_, _) = tokio::try_join!(producer, consumer)?;",
			"    let mut collected = Vec::new();",
			"    while let Some(result) = result_rx.recv().await {",
			"        collected.push(result);",
			"    }",
			"    Ok(collected)",
			"}",
			"$0"
		],
		"description": "Producer and consumer linked by tokio mpsc channels"
	},
	"Concurrency: Rate Limiter": {
		"prefix": "cc-rate-limiter",
		"body": [
			"struct ${1:TokenBucket} {",
			"    tokens: tokio::sync::Mutex<u32>,",
			"    capacity: u32,",
			"    interval: tokio::time::Interval,",
			"}",
			"",
			"impl ${1:TokenBucket} {",
			"    fn new(rate_per_sec: u32, capacity: u32) -> Self {",
			"        Self {",
			"            tokens: tokio::sync::Mutex::new(capacity),",
			"            capacity,",
			"            interval: tokio::time::interval(Duration::from_secs(1) / rate_per_sec),",
			"        }",
			"    }",
			"",
			"    async fn acquire(&self) {",
			"        loop {",
			"            {",
			"                let mut tokens = self.tokens.lock().await;",
			"                if *tokens > 0 {",
			"                    *tokens -= 1;",
			"                    return;",
			"                }",
			"            }",
			"            self.interval.tick().await;",
			"            let mut tokens = self.tokens.lock().await;",
			"            *tokens = (*tokens + 1).min(self.capacity);",
			"        }",
			"    }",
			"}",
			"$0"
		],
		"description": "Async token-bucket rate limiter with tokio interval refill"
	},
	"Concurrency: Fan-Out Fan-In": {
		"prefix": "cc-fan-out-fan-in",
		"body": [
			"async fn ${1:fan_out_fan_in}<T, R>(",
			"    items: Vec<T>,",
			"    worker_count: usize,",
			"    transform: impl Fn(T) -> R + Send + Sync + Copy + 'static,",
			") -> Vec<R>",
			"where",
			"    T: Send + Clone + 'static,",
			"    R: Send + 'static,",
			"{",
			"    let (tx, mut rx) = tokio::sync::mpsc::channel(worker_count);",
			"    let items = Arc::new(items);",
			"",
			"    let handles: Vec<_> = (0..worker_count)",
			"        .map(|worker_id| {",
			"            let tx = tx.clone();",
			"            let items = Arc::clone(&items);",
			"            tokio::spawn(async move {",
			"                for (index, item) in items.iter().enumerate().filter(|(i, _)| i % worker_count == worker_id) {",
			"                    tx.send((index, transform(item.clone()))).await.unwrap();",
			"                }",
			"            })",
			"        })",
			"        .collect();",
			"",
			"    drop(tx);",
			"    for handle in handles {",
			"        handle.await.unwrap();",
			"    }",
			"",
			"    let mut results: Vec<Option<R>> = vec![None; items.len()];",
			"    while let Some((index, value)) = rx.recv().await {",
			"        results[index] = Some(value);",
			"    }",
			"    results.into_iter().map(|r| r.unwrap()).collect()",
			"}",
			"$0"
		],
		"description": "Fan items to tokio workers and merge indexed results"
	},
	"Concurrency: Context Cancel": {
		"prefix": "cc-context-cancel",
		"body": [
			"async fn ${1:run_with_cancel}() -> Result<(), Box<dyn std::error::Error + Send + Sync>> {",
			"    let (cancel_tx, cancel_rx) = tokio::sync::oneshot::channel::<()>();",
			"",
			"    let handle = tokio::spawn(async move {",
			"        if ${2:long_running_work}().await.is_err() {",
			"            let _ = cancel_tx.send(());",
			"        }",
			"    });",
			"",
			"    tokio::select! {",
			"        _ = cancel_rx => {",
			"            handle.abort();",
			"            Ok(())",
			"        }",
			"        result = handle => {",
			"            result??;",
			"            Ok(())",
			"        }",
			"    }",
			"}",
			"$0"
		],
		"description": "Cancel propagation via oneshot channel and tokio::select!"
	},
	"Concurrency: Async Stream": {
		"prefix": "cc-async-stream",
		"body": [
			"async fn ${1:stream_items}() -> tokio::sync::mpsc::Receiver<${2:Item}> {",
			"    let (tx, rx) = tokio::sync::mpsc::channel(${3:16});",
			"    tokio::spawn(async move {",
			"        for i in 0..${4:100} {",
			"            if tx.send(${2:Item} { id: i }).await.is_err() {",
			"                break;",
			"            }",
			"        }",
			"    });",
			"    rx",
			"}",
			"",
			"async fn ${5:consume_stream}() -> Result<(), Box<dyn std::error::Error + Send + Sync>> {",
			"    let mut stream = ${1:stream_items}().await;",
			"    while let Some(item) = stream.recv().await {",
			"        ${6:process_item}(item).await?;",
			"    }",
			"    Ok(())",
			"}",
			"$0"
		],
		"description": "Mpsc receiver stream with spawned producer and recv loop"
	},
	"Concurrency: Semaphore": {
		"prefix": "cc-semaphore",
		"body": [
			"async fn ${1:run_with_semaphore}(",
			"    semaphore: Arc<tokio::sync::Semaphore>,",
			") -> Result<(), Box<dyn std::error::Error + Send + Sync>> {",
			"    let permit = semaphore.acquire().await?;",
			"    ${2:limited_work}().await?;",
			"    drop(permit);",
			"    Ok(())",
			"}",
			"",
			"async fn ${3:main}() -> Result<(), Box<dyn std::error::Error + Send + Sync>> {",
			"    let semaphore = Arc::new(tokio::sync::Semaphore::new(${4:5}));",
			"    let handles: Vec<_> = (0..${5:20})",
			"        .map(|_| {",
			"            let semaphore = Arc::clone(&semaphore);",
			"            tokio::spawn(${1:run_with_semaphore}(semaphore))",
			"        })",
			"        .collect();",
			"    for handle in handles {",
			"        handle.await??;",
			"    }",
			"    Ok(())",
			"}",
			"$0"
		],
		"description": "tokio::sync::Semaphore limiting concurrent async access"
	}
}
