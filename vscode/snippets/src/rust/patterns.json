{
	"DP Creational: Abstract Factory": {
		"prefix": "dp-creational-abstract-factory",
		"body": [
			"trait ${1:ProductA} { fn name(&self) -> &str; }",
			"trait ${2:ProductB} { fn name(&self) -> &str; }",
			"",
			"struct ${3:ProductA1};",
			"impl ${1:ProductA} for ${3:ProductA1} { fn name(&self) -> &str { \"${3:ProductA1}\" } }",
			"struct ${4:ProductB1};",
			"impl ${2:ProductB} for ${4:ProductB1} { fn name(&self) -> &str { \"${4:ProductB1}\" } }",
			"",
			"struct ${5:ProductA2};",
			"impl ${1:ProductA} for ${5:ProductA2} { fn name(&self) -> &str { \"${5:ProductA2}\" } }",
			"struct ${6:ProductB2};",
			"impl ${2:ProductB} for ${6:ProductB2} { fn name(&self) -> &str { \"${6:ProductB2}\" } }",
			"",
			"trait ${7:AbstractFactory} {",
			"    fn create_a(&self) -> Box<dyn ${1:ProductA}>;",
			"    fn create_b(&self) -> Box<dyn ${2:ProductB}>;",
			"}",
			"",
			"struct ${8:Factory1};",
			"impl ${7:AbstractFactory} for ${8:Factory1} {",
			"    fn create_a(&self) -> Box<dyn ${1:ProductA}> { Box::new(${3:ProductA1}) }",
			"    fn create_b(&self) -> Box<dyn ${2:ProductB}> { Box::new(${4:ProductB1}) }",
			"}",
			"",
			"struct ${9:Factory2};",
			"impl ${7:AbstractFactory} for ${9:Factory2} {",
			"    fn create_a(&self) -> Box<dyn ${1:ProductA}> { Box::new(${5:ProductA2}) }",
			"    fn create_b(&self) -> Box<dyn ${2:ProductB}> { Box::new(${6:ProductB2}) }",
			"}",
			"$0"
		],
		"description": "GoF Abstract Factory \u2014 family of related products via factory trait"
	},
	"DP Creational: Builder": {
		"prefix": "dp-creational-builder",
		"body": [
			"#[derive(Debug, Default)]",
			"struct ${1:Product} {",
			"    ${2:part_a}: String,",
			"    ${3:part_b}: String,",
			"}",
			"",
			"struct ${4:Builder} {",
			"    ${2:part_a}: String,",
			"    ${3:part_b}: String,",
			"}",
			"",
			"impl ${4:Builder} {",
			"    fn new() -> Self { Self { ${2:part_a}: String::new(), ${3:part_b}: String::new() } }",
			"    fn ${2:part_a}(mut self, value: impl Into<String>) -> Self {",
			"        self.${2:part_a} = value.into(); self",
			"    }",
			"    fn ${3:part_b}(mut self, value: impl Into<String>) -> Self {",
			"        self.${3:part_b} = value.into(); self",
			"    }",
			"    fn build(self) -> ${1:Product} {",
			"        ${1:Product} { ${2:part_a}: self.${2:part_a}, ${3:part_b}: self.${3:part_b} }",
			"    }",
			"}",
			"$0"
		],
		"description": "GoF Builder \u2014 fluent builder constructing a product step by step"
	},
	"DP Creational: Prototype": {
		"prefix": "dp-creational-prototype",
		"body": [
			"#[derive(Clone, Debug)]",
			"struct ${1:Prototype} {",
			"    ${2:field}: String,",
			"}",
			"",
			"impl ${1:Prototype} {",
			"    fn new(${2:field}: impl Into<String>) -> Self {",
			"        Self { ${2:field}: ${2:field}.into() }",
			"    }",
			"    fn clone_with(&self, ${2:field}: impl Into<String>) -> Self {",
			"        Self { ${2:field}: ${2:field}.into() }",
			"    }",
			"}",
			"",
			"struct ${3:PrototypeRegistry} {",
			"    prototypes: std::collections::HashMap<String, ${1:Prototype}>,",
			"}",
			"",
			"impl ${3:PrototypeRegistry} {",
			"    fn register(&mut self, key: &str, proto: ${1:Prototype}) {",
			"        self.prototypes.insert(key.to_string(), proto);",
			"    }",
			"    fn acquire(&self, key: &str) -> Option<${1:Prototype}> {",
			"        self.prototypes.get(key).cloned()",
			"    }",
			"}",
			"$0"
		],
		"description": "GoF Prototype \u2014 Clone-based copying with optional registry"
	},
	"DP Creational: Singleton": {
		"prefix": "dp-creational-singleton",
		"body": [
			"use std::sync::{Mutex, OnceLock};",
			"",
			"struct ${1:Singleton} {",
			"    ${2:state}: String,",
			"}",
			"",
			"impl ${1:Singleton} {",
			"    fn instance() -> &'static Mutex<${1:Singleton}> {",
			"        static INSTANCE: OnceLock<Mutex<${1:Singleton}>> = OnceLock::new();",
			"        INSTANCE.get_or_init(|| {",
			"            Mutex::new(${1:Singleton} { ${2:state}: String::new() })",
			"        })",
			"    }",
			"    fn get_state(&self) -> &str { &self.${2:state} }",
			"    fn set_state(&mut self, value: impl Into<String>) {",
			"        self.${2:state} = value.into();",
			"    }",
			"}",
			"$0"
		],
		"description": "GoF Singleton \u2014 OnceLock + Mutex for thread-safe single instance"
	},
	"DP Structural: Adapter": {
		"prefix": "dp-structural-adapter",
		"body": [
			"trait ${1:Target} {",
			"    fn request(&self) -> String;",
			"}",
			"",
			"struct ${2:Adaptee};",
			"impl ${2:Adaptee} {",
			"    fn specific_request(&self) -> String { \"${2:Adaptee}\".into() }",
			"}",
			"",
			"struct ${3:Adapter} {",
			"    adaptee: ${2:Adaptee},",
			"}",
			"",
			"impl ${3:Adapter} {",
			"    fn new(adaptee: ${2:Adaptee}) -> Self { Self { adaptee } }",
			"}",
			"",
			"impl ${1:Target} for ${3:Adapter} {",
			"    fn request(&self) -> String {",
			"        self.adaptee.specific_request()",
			"    }",
			"}",
			"$0"
		],
		"description": "GoF Adapter \u2014 wraps Adaptee to implement Target trait"
	},
	"DP Structural: Bridge": {
		"prefix": "dp-structural-bridge",
		"body": [
			"trait ${1:Implementation} {",
			"    fn operation_impl(&self) -> String;",
			"}",
			"",
			"struct ${2:ConcreteImplementationA};",
			"impl ${1:Implementation} for ${2:ConcreteImplementationA} {",
			"    fn operation_impl(&self) -> String { \"${2:ConcreteImplementationA}\".into() }",
			"}",
			"",
			"struct ${3:ConcreteImplementationB};",
			"impl ${1:Implementation} for ${3:ConcreteImplementationB} {",
			"    fn operation_impl(&self) -> String { \"${3:ConcreteImplementationB}\".into() }",
			"}",
			"",
			"struct ${4:Abstraction} {",
			"    implementation: Box<dyn ${1:Implementation}>,",
			"}",
			"",
			"impl ${4:Abstraction} {",
			"    fn new(implementation: Box<dyn ${1:Implementation}>) -> Self {",
			"        Self { implementation }",
			"    }",
			"    fn operation(&self) -> String {",
			"        format!(\"Abstraction -> {}\", self.implementation.operation_impl())",
			"    }",
			"}",
			"$0"
		],
		"description": "GoF Bridge \u2014 abstraction holds Box<dyn Implementation>"
	},
	"DP Structural: Composite": {
		"prefix": "dp-structural-composite",
		"body": [
			"trait ${1:Component} {",
			"    fn operation(&self) -> String;",
			"}",
			"",
			"struct ${2:Leaf} {",
			"    name: String,",
			"}",
			"",
			"impl ${1:Component} for ${2:Leaf} {",
			"    fn operation(&self) -> String { self.name.clone() }",
			"}",
			"",
			"struct ${3:Composite} {",
			"    children: Vec<Box<dyn ${1:Component}>>,",
			"}",
			"",
			"impl ${3:Composite} {",
			"    fn new() -> Self { Self { children: Vec::new() } }",
			"    fn add(&mut self, child: Box<dyn ${1:Component}>) {",
			"        self.children.push(child);",
			"    }",
			"}",
			"",
			"impl ${1:Component} for ${3:Composite} {",
			"    fn operation(&self) -> String {",
			"        self.children.iter().map(|c| c.operation()).collect::<Vec<_>>().join(\", \")",
			"    }",
			"}",
			"$0"
		],
		"description": "GoF Composite \u2014 tree of Leaf and Composite via shared Component trait"
	},
	"DP Structural: Decorator": {
