			"struct ${3:SubsystemB};",
			"impl ${3:SubsystemB} { fn operation_b(&self) -> String { \"${3:SubsystemB}\".into() } }",
			"",
			"struct ${1:Facade} {",
			"    subsystem_a: ${2:SubsystemA},",
			"    subsystem_b: ${3:SubsystemB},",
			"}",
			"",
			"impl ${1:Facade} {",
			"    fn new() -> Self {",
			"        Self { subsystem_a: ${2:SubsystemA}, subsystem_b: ${3:SubsystemB} }",
			"    }",
			"    fn operation(&self) -> String {",
			"        format!(\"{} + {}\", self.subsystem_a.operation_a(), self.subsystem_b.operation_b())",
