			"    fn iter(&self) -> ${2:Iterator}<'_> {",
			"        ${2:Iterator} { inner: self.items.iter() }",
			"    }",
			"}",
			"",
			"struct ${2:Iterator}<'a> {",
			"    inner: std::slice::Iter<'a, String>,",
			"}",
			"",
			"impl<'a> Iterator for ${2:Iterator}<'a> {",
			"    type Item = &'a String;",
			"    fn next(&mut self) -> Option<Self::Item> { self.inner.next() }",
			"}",
			"$0"
		],
		"description": "GoF Iterator \u2014 aggregate exposes custom iterator over collection"
	},
	"DP Behavioral: Mediator": {
		"prefix": "dp-behavioral-mediator",
		"body": [
			"trait ${1:Mediator} {",
			"    fn notify(&self, sender: &str, event: &str);",
			"}",
			"",
			"struct ${2:ConcreteMediator} {",
			"    ${3:colleague_a}: String,",
			"    ${4:colleague_b}: String,",
			"}",
			"",
			"impl ${1:Mediator} for ${2:ConcreteMediator} {",
			"    fn notify(&self, sender: &str, event: &str) {",
			"        if sender == self.${3:colleague_a} {",
			"            println!(\"{} reacts to {}\", self.${4:colleague_b}, event);",
			"        }",
			"    }",
			"}",
			"",
			"struct ${5:Colleague} {",
			"    name: String,",
			"    mediator: Box<dyn ${1:Mediator}>,",
			"}",
			"",
			"impl ${5:Colleague} {",
			"    fn send(&self, event: &str) {",
			"        self.mediator.notify(&self.name, event);",
			"    }",
			"}",
			"$0"
		],
		"description": "GoF Mediator \u2014 central coordinator for colleague communication"
	},
	"DP Behavioral: Memento": {
		"prefix": "dp-behavioral-memento",
		"body": [
			"#[derive(Clone)]",
			"struct ${2:Memento} {",
			"    ${3:state}: String,",
			"}",
			"",
			"struct ${1:Originator} {",
			"    ${3:state}: String,",
			"}",
			"",
			"impl ${1:Originator} {",
			"    fn new(${3:state}: impl Into<String>) -> Self {",
			"        Self { ${3:state}: ${3:state}.into() }",
			"    }",
			"    fn set_state(&mut self, value: impl Into<String>) {",
			"        self.${3:state} = value.into();",
			"    }",
			"    fn save(&self) -> ${2:Memento} {",
			"        ${2:Memento} { ${3:state}: self.${3:state}.clone() }",
			"    }",
			"    fn restore(&mut self, memento: ${2:Memento}) {",
			"        self.${3:state} = memento.${3:state};",
			"    }",
			"}",
			"",
			"struct ${4:Caretaker} {",
			"    history: Vec<${2:Memento}>,",
			"}",
			"",
			"impl ${4:Caretaker} {",
			"    fn push(&mut self, m: ${2:Memento}) { self.history.push(m); }",
			"    fn pop(&mut self) -> Option<${2:Memento}> { self.history.pop() }",
			"}",
			"$0"
		],
		"description": "GoF Memento \u2014 Originator snapshots state; Caretaker stores history"
	},
	"DP Behavioral: Observer": {
		"prefix": "dp-behavioral-observer",
		"body": [
			"trait ${1:Observer} {",
			"    fn update(&self, event: &str);",
			"}",
			"",
			"struct ${2:ConcreteObserver} {",
			"    name: String,",
			"}",
			"",
			"impl ${1:Observer} for ${2:ConcreteObserver} {",
			"    fn update(&self, event: &str) {",
			"        println!(\"{}: {}\", self.name, event);",
			"    }",
			"}",
			"",
			"struct ${3:Subject} {",
			"    observers: Vec<Box<dyn ${1:Observer}>>,",
			"}",
			"",
			"impl ${3:Subject} {",
			"    fn attach(&mut self, observer: Box<dyn ${1:Observer}>) {",
			"        self.observers.push(observer);",
			"    }",
			"    fn notify(&self, event: &str) {",
			"        for obs in &self.observers { obs.update(event); }",
			"    }",
			"}",
			"$0"
		],
		"description": "GoF Observer \u2014 subject notifies attached observers of changes"
	},
	"DP Behavioral: State": {
		"prefix": "dp-behavioral-state",
		"body": [
			"trait ${2:State} {",
			"    fn handle(&self, context: &mut ${1:Context});",
			"}",
			"",
			"struct ${3:ConcreteStateA};",
			"impl ${2:State} for ${3:ConcreteStateA} {",
			"    fn handle(&self, context: &mut ${1:Context}) {",
			"        context.set_state(Box::new(${4:ConcreteStateB}));",
			"    }",
			"}",
			"",
			"struct ${4:ConcreteStateB};",
			"impl ${2:State} for ${4:ConcreteStateB} {",
			"    fn handle(&self, context: &mut ${1:Context}) {",
			"        context.set_state(Box::new(${3:ConcreteStateA}));",
			"    }",
			"}",
			"",
			"struct ${1:Context} {",
			"    state: Box<dyn ${2:State}>,",
			"}",
			"",
			"impl ${1:Context} {",
			"    fn new(state: Box<dyn ${2:State}>) -> Self { Self { state } }",
			"    fn set_state(&mut self, state: Box<dyn ${2:State}>) { self.state = state; }",
			"    fn request(&mut self) { self.state.handle(self); }",
			"}",
			"$0"
		],
		"description": "GoF State \u2014 context delegates behavior to interchangeable state objects"
	},
	"DP Behavioral: Strategy": {
		"prefix": "dp-behavioral-strategy",
		"body": [
			"trait ${1:Strategy} {",
			"    fn execute(&self, data: &str) -> String;",
			"}",
			"",
			"struct ${2:ConcreteStrategyA};",
			"impl ${1:Strategy} for ${2:ConcreteStrategyA} {",
			"    fn execute(&self, data: &str) -> String { format!(\"A: {}\", data) }",
			"}",
			"",
			"struct ${3:ConcreteStrategyB};",
			"impl ${1:Strategy} for ${3:ConcreteStrategyB} {",
			"    fn execute(&self, data: &str) -> String { format!(\"B: {}\", data) }",
			"}",
			"",
			"struct ${4:Context} {",
			"    strategy: Box<dyn ${1:Strategy}>,",
			"}",
