	"DP Structural: Flyweight": {
		"prefix": "dp-structural-flyweight",
		"body": [
			"use std::collections::HashMap;",
			"",
			"#[derive(Clone)]",
			"struct ${1:Flyweight} {",
			"    ${2:intrinsic}: String,",
			"}",
			"",
			"impl ${1:Flyweight} {",
			"    fn operation(&self, ${3:extrinsic}: &str) -> String {",
			"        format!(\"{}:{}\", self.${2:intrinsic}, ${3:extrinsic})",
			"    }",
			"}",
			"",
			"struct ${4:FlyweightFactory} {",
			"    pool: HashMap<String, ${1:Flyweight}>,",
			"}",
			"",
			"impl ${4:FlyweightFactory} {",
			"    fn new() -> Self { Self { pool: HashMap::new() } }",
			"    fn get(&mut self, key: &str) -> ${1:Flyweight} {",
			"        self.pool.entry(key.to_string()).or_insert_with(|| {",
			"            ${1:Flyweight} { ${2:intrinsic}: key.to_string() }",
			"        }).clone()",
			"    }",
			"}",
			"$0"
		],
		"description": "GoF Flyweight \u2014 shared intrinsic state via factory pool"
	},
	"DP Structural: Proxy": {
		"prefix": "dp-structural-proxy",
		"body": [
			"trait ${1:Subject} {",
			"    fn request(&self) -> String;",
			"}",
			"",
			"struct ${2:RealSubject};",
			"impl ${1:Subject} for ${2:RealSubject} {",
			"    fn request(&self) -> String { \"${2:RealSubject}\".into() }",
			"}",
			"",
			"struct ${3:Proxy} {",
			"    real: Option<${2:RealSubject}>,",
			"}",
			"",
			"impl ${3:Proxy} {",
			"    fn new() -> Self { Self { real: None } }",
			"    fn lazy_init(&mut self) {",
			"        if self.real.is_none() {",
			"            self.real = Some(${2:RealSubject});",
			"        }",
			"    }",
			"}",
			"",
			"impl ${1:Subject} for ${3:Proxy} {",
			"    fn request(&self) -> String {",
			"        self.real.as_ref().map(|r| r.request()).unwrap_or_default()",
			"    }",
			"}",
			"$0"
		],
		"description": "GoF Proxy \u2014 lazy-initialized surrogate controlling access to RealSubject"
	},
	"DP Behavioral: Chain of Responsibility": {
		"prefix": "dp-behavioral-chain",
		"body": [
			"trait ${1:Handler} {",
			"    fn set_next(&mut self, next: Box<dyn ${1:Handler}>);",
			"    fn handle(&self, request: &str) -> Option<String>;",
			"}",
			"",
			"struct ${2:BaseHandler} {",
			"    next: Option<Box<dyn ${1:Handler}>>,",
			"}",
			"",
			"impl ${2:BaseHandler} {",
			"    fn new() -> Self { Self { next: None } }",
			"}",
			"",
			"impl ${1:Handler} for ${2:BaseHandler} {",
			"    fn set_next(&mut self, next: Box<dyn ${1:Handler}>) { self.next = Some(next); }",
			"    fn handle(&self, request: &str) -> Option<String> {",
			"        self.next.as_ref().and_then(|n| n.handle(request))",
			"    }",
			"}",
			"",
			"struct ${3:ConcreteHandler};",
			"impl ${1:Handler} for ${3:ConcreteHandler} {",
			"    fn set_next(&mut self, _: Box<dyn ${1:Handler}>) {}",
			"    fn handle(&self, request: &str) -> Option<String> {",
			"        if request.contains(\"${3:ConcreteHandler}\") {",
			"            Some(format!(\"handled by ${3:ConcreteHandler}\"))",
			"        } else { None }",
			"    }",
			"}",
			"$0"
		],
		"description": "GoF Chain of Responsibility \u2014 linked handlers passing requests along"
	},
	"DP Behavioral: Command": {
		"prefix": "dp-behavioral-command",
		"body": [
			"trait ${1:Command} {",
			"    fn execute(&self);",
			"    fn undo(&self);",
			"}",
			"",
			"struct ${2:Receiver};",
			"impl ${2:Receiver} {",
			"    fn action(&self) { /* perform action */ }",
			"}",
			"",
			"struct ${3:ConcreteCommand} {",
			"    receiver: ${2:Receiver},",
			"}",
			"",
			"impl ${1:Command} for ${3:ConcreteCommand} {",
			"    fn execute(&self) { self.receiver.action(); }",
			"    fn undo(&self) { /* reverse action */ }",
			"}",
			"",
			"struct ${4:Invoker} {",
			"    history: Vec<Box<dyn ${1:Command}>>,",
			"}",
			"",
			"impl ${4:Invoker} {",
			"    fn run(&mut self, cmd: Box<dyn ${1:Command}>) {",
			"        cmd.execute();",
			"        self.history.push(cmd);",
			"    }",
			"}",
			"$0"
		],
		"description": "GoF Command \u2014 encapsulates request as object with execute/undo"
	},
	"DP Behavioral: Iterator": {
		"prefix": "dp-behavioral-iterator",
		"body": [
