			"    let dirs = [(0, 1), (0, -1), (1, 0), (-1, 0)];",
			"    let mut visited = HashSet::new();",
			"    let mut q = VecDeque::from([(sr, sc, 0)]);",
			"    visited.insert((sr, sc));",
			"    while let Some((r, c, dist)) = q.pop_front() {",
			"        if r == tr && c == tc {",
			"            return dist;",
			"        }",
			"        for (dr, dc) in dirs {",
			"            let nr = r + dr;",
			"            let nc = c + dc;",
			"            if nr < 0 || nr >= rows || nc < 0 || nc >= cols {",
			"                continue;",
			"            }",
