			"fn topo_sort(n: usize, edges: &[(usize, usize)]) -> Vec<usize> {",
			"    let mut adj = vec![vec![]; n];",
			"    let mut indeg = vec![0; n];",
			"    for &(u, v) in edges {",
			"        adj[u].push(v);",
			"        indeg[v] += 1;",
			"    }",
			"    let mut q: VecDeque<usize> = (0..n).filter(|&i| indeg[i] == 0).collect();",
			"    let mut order = Vec::with_capacity(n);",
