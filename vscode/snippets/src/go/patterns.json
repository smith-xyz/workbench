	"DP Behavioral: Chain of Responsibility": {
		"prefix": "dp-behavioral-chain",
		"body": [
			"type ${1:Handler} interface {",
			"\tSetNext(${1:Handler})",
			"\tHandle(request string) (string, bool)",
			"}",
			"",
			"type base${1:Handler} struct {",
			"\tnext ${1:Handler}",
			"}",
			"",
			"func (h *base${1:Handler}) SetNext(next ${1:Handler}) {",
			"\th.next = next",
			"}",
			"",
			"type Concrete${1:Handler} struct {",
			"\tbase${1:Handler}",
			"}",
			"",
			"func (h *Concrete${1:Handler}) Handle(request string) (string, bool) {",
			"\tif request == \"handle\" {",
			"\t\treturn \"handled\", true",
			"\t}",
			"\tif h.next != nil {",
			"\t\treturn h.next.Handle(request)",
			"\t}",
			"\treturn \"\", false",
			"}",
			"$0"
		],
		"description": "GoF Chain of Responsibility \u2014 linked handlers"
	},
