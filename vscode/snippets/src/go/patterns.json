	"DP Behavioral: Mediator": {
		"prefix": "dp-behavioral-mediator",
		"body": [
			"type ${1:Mediator} interface {",
			"\tNotify(sender ${2:Colleague}, event string)",
			"}",
			"",
			"type ${2:Colleague} interface {",
			"\tSetMediator(${1:Mediator})",
			"\tSend(event string)",
			"}",
			"",
			"type Concrete${1:Mediator} struct {",
			"\tcolleagues []${2:Colleague}",
			"}",
			"",
			"func (m *Concrete${1:Mediator}) Register(c ${2:Colleague}) {",
			"\tc.SetMediator(m)",
			"\tm.colleagues = append(m.colleagues, c)",
			"}",
			"",
			"func (m *Concrete${1:Mediator}) Notify(sender ${2:Colleague}, event string) {",
			"\tfor _, c := range m.colleagues {",
			"\t\tif c != sender {",
			"\t\t\tc.Send(event)",
			"\t\t}",
			"\t}",
			"}",
			"",
			"type Concrete${2:Colleague} struct {",
			"\tmediator ${1:Mediator}",
			"}",
			"",
			"func (c *Concrete${2:Colleague}) SetMediator(m ${1:Mediator}) { c.mediator = m }",
			"func (c *Concrete${2:Colleague}) Send(event string) {",
			"\tif c.mediator != nil {",
			"\t\tc.mediator.Notify(c, event)",
			"\t}",
			"}",
			"$0"
		],
		"description": "GoF Mediator \u2014 central coordinator for colleagues"
	},
	"DP Behavioral: Memento": {
		"prefix": "dp-behavioral-memento",
		"body": [
			"type ${2:Memento} struct {",
			"\tstate string",
			"}",
			"",
			"type ${1:Originator} struct {",
			"\tstate string",
			"}",
			"",
			"func (o *${1:Originator}) SetState(s string) { o.state = s }",
