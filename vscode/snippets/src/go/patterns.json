			"func (o *${1:Originator}) Restore(m ${2:Memento}) { o.state = m.state }",
			"",
			"type ${3:Caretaker} struct {",
			"\tmementos []${2:Memento}",
			"}",
			"",
			"func (c *${3:Caretaker}) Push(m ${2:Memento}) {",
			"\tc.mementos = append(c.mementos, m)",
			"}",
			"",
			"func (c *${3:Caretaker}) Pop() ${2:Memento} {",
			"\tn := len(c.mementos) - 1",
			"\tm := c.mementos[n]",
			"\tc.mementos = c.mementos[:n]",
			"\treturn m",
			"}",
			"$0"
		],
		"description": "GoF Memento \u2014 originator, memento, caretaker"
	},
	"DP Behavioral: Observer": {
		"prefix": "dp-behavioral-observer",
		"body": [
			"type ${2:Observer} interface {",
			"\tUpdate(event string)",
			"}",
			"",
			"type ${1:Subject} struct {",
			"\tobservers []${2:Observer}",
			"\tnotify    chan string",
			"}",
			"",
			"func New${1:Subject}() *${1:Subject} {",
			"\ts := &${1:Subject}{notify: make(chan string, 1)}",
			"\tgo func() {",
			"\t\tfor event := range s.notify {",
			"\t\t\tfor _, o := range s.observers {",
			"\t\t\t\to.Update(event)",
			"\t\t\t}",
			"\t\t}",
			"\t}()",
			"\treturn s",
			"}",
			"",
			"func (s *${1:Subject}) Attach(o ${2:Observer}) {",
			"\ts.observers = append(s.observers, o)",
			"}",
			"",
			"func (s *${1:Subject}) Notify(event string) { s.notify <- event }",
			"",
			"type Concrete${2:Observer} struct {",
			"\tid string",
			"}",
			"",
			"func (o *Concrete${2:Observer}) Update(event string) {}",
			"$0"
		],
		"description": "GoF Observer \u2014 subject broadcasts via channel to observers"
	},
