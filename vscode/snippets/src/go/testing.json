{
	"Testing: Table Driven": {
		"prefix": "tt-table-driven",
		"body": [
			"func Test${1:ParseDuration}(t *testing.T) {",
			"\ttests := []struct {",
			"\t\tname  string",
			"\t\tinput string",
			"\t\twant  time.Duration",
			"\t}{",
			"\t\t{\"seconds\", \"5s\", 5 * time.Second},",
			"\t\t{\"minutes\", \"2m\", 2 * time.Minute},",
			"\t\t{\"invalid\", \"bad\", 0},",
			"\t}",
			"",
			"\tfor _, tt := range tests {",
			"\t\tt.Run(tt.name, func(t *testing.T) {",
			"\t\t\tgot, err := ${1:ParseDuration}(tt.input)",
			"\t\t\tif tt.want == 0 {",
			"\t\t\t\tif err == nil {",
			"\t\t\t\t\tt.Fatal(\"expected error\")",
			"\t\t\t\t}",
			"\t\t\t\treturn",
			"\t\t\t}",
			"\t\t\tif err != nil {",
			"\t\t\t\tt.Fatalf(\"unexpected error: %v\", err)",
			"\t\t\t}",
			"\t\t\tif got != tt.want {",
			"\t\t\t\tt.Fatalf(\"got %v, want %v\", got, tt.want)",
			"\t\t\t}",
			"\t\t\t$0",
			"\t\t})",
			"\t}",
			"}"
		],
		"description": "Table-driven subtests with t.Run and multiple cases"
	},
	"Testing: Mock": {
		"prefix": "tt-mock",
		"body": [
			"type ${1:Notifier} interface {",
			"\tSend(ctx context.Context, message string) error",
			"}",
			"",
			"type mock${1:Notifier} struct {",
			"\tmessages []string",
			"\terr      error",
			"}",
			"",
			"func (m *mock${1:Notifier}) Send(ctx context.Context, message string) error {",
			"\tif m.err != nil {",
			"\t\treturn m.err",
			"\t}",
			"\tm.messages = append(m.messages, message)",
			"\treturn nil",
			"}",
			"",
			"func Test${2:OrderService}_SendsConfirmation(t *testing.T) {",
			"\tmock := &mock${1:Notifier}{}",
			"\tsvc := New${2:OrderService}(mock)",
			"",
			"\tif err := svc.ConfirmOrder(context.Background(), \"order-42\"); err != nil {",
			"\t\tt.Fatalf(\"ConfirmOrder: %v\", err)",
			"\t}",
			"\tif len(mock.messages) != 1 {",
			"\t\tt.Fatalf(\"got %d messages, want 1\", len(mock.messages))",
			"\t}",
			"\t$0",
			"}"
		],
		"description": "Mock struct implementing an interface for unit tests"
	},
	"Testing: Fixture": {
		"prefix": "tt-fixture",
		"body": [
			"func setup${1:UserRepository}(t *testing.T) *${1:UserRepository} {",
			"\tt.Helper()",
			"\tdb, err := sql.Open(\"sqlite3\", \":memory:\")",
			"\tif err != nil {",
			"\t\tt.Fatalf(\"open db: %v\", err)",
			"\t}",
			"\tif _, err := db.Exec(`CREATE TABLE users (id TEXT PRIMARY KEY, email TEXT)`); err != nil {",
			"\t\tt.Fatalf(\"create table: %v\", err)",
			"\t}",
			"\trepo := New${1:UserRepository}(db)",
			"\tt.Cleanup(func() {",
			"\t\tif err := db.Close(); err != nil {",
			"\t\t\tt.Errorf(\"close db: %v\", err)",
			"\t\t}",
			"\t})",
			"\treturn repo",
			"}",
			"",
			"func Test${1:UserRepository}_Create(t *testing.T) {",
			"\trepo := setup${1:UserRepository}(t)",
			"\tuser := User{ID: \"u-1\", Email: \"alice@example.com\"}",
			"",
			"\tif err := repo.Create(context.Background(), user); err != nil {",
			"\t\tt.Fatalf(\"Create: %v\", err)",
			"\t}",
			"\t$0",
			"}"
		],
		"description": "Test fixture with setup helper and t.Cleanup teardown"
	},
	"Testing: Property": {
		"prefix": "tt-property",
		"body": [
			"func Fuzz${1:ReverseString}(f *testing.F) {",
			"\tf.Add(\"hello\")",
			"\tf.Add(\"\")",
			"\tf.Add(\"racecar\")",
			"",
			"\tf.Fuzz(func(t *testing.T, input string) {",
			"\t\tdouble := ${1:ReverseString}(${1:ReverseString}(input))",
			"\t\tif double != input {",
			"\t\t\tt.Fatalf(\"reverse twice changed value: %q -> %q\", input, double)",
			"\t\t}",
			"\t\t$0",
			"\t})",
			"}"
		],
		"description": "Go fuzz test with seed corpus and Fuzz callback"
	},
	"Testing: Benchmark": {
		"prefix": "tt-benchmark",
		"body": [
			"func Benchmark${1:EncodeJSON}(b *testing.B) {",
			"\tpayload := map[string]any{",
			"\t\t\"id\":   \"session-9f3a\",",
			"\t\t\"user\": \"alice\",",
			"\t\t\"roles\": []string{\"admin\", \"editor\"},",
			"\t}",
			"\tb.ResetTimer()",
			"",
			"\tfor i := 0; i < b.N; i++ {",
			"\t\tif _, err := ${1:EncodeJSON}(payload); err != nil {",
			"\t\t\tb.Fatalf(\"EncodeJSON: %v\", err)",
			"\t\t}",
			"\t}",
			"\t$0",
			"}"
		],
		"description": "Benchmark function using testing.B and b.Loop"
	},
	"Testing: HTTP Mock": {
		"prefix": "tt-http-mock",
		"body": [
			"func Test${1:WeatherClient}_GetForecast(t *testing.T) {",
			"\tserver := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {",
			"\t\tif r.URL.Path != \"/forecast\" {",
			"\t\t\thttp.NotFound(w, r)",
			"\t\t\treturn",
			"\t\t}",
			"\t\tw.Header().Set(\"Content-Type\", \"application/json\")",
			"\t\t_, _ = w.Write([]byte(`{\"city\":\"Portland\",\"temp_c\":18}`))",
			"\t}))",
			"\tdefer server.Close()",
			"",
			"\tclient := New${1:WeatherClient}(server.URL)",
			"\tforecast, err := client.GetForecast(context.Background(), \"Portland\")",
			"\tif err != nil {",
			"\t\tt.Fatalf(\"GetForecast: %v\", err)",
			"\t}",
			"\tif forecast.TempC != 18 {",
			"\t\tt.Fatalf(\"got temp %d, want 18\", forecast.TempC)",
			"\t}",
			"\t$0",
			"}"
		],
		"description": "httptest.NewServer mock for API client integration tests"
	},
	"Testing: Helper": {
		"prefix": "tt-helper",
		"body": [
			"func assert${1:EqualString}(t *testing.T, got, want string) {",
			"\tt.Helper()",
			"\tif got != want {",
			"\t\tt.Fatalf(\"got %q, want %q\", got, want)",
			"\t}",
			"}",
			"",
			"func Test${2:Slugify}_ProducesExpectedSlug(t *testing.T) {",
			"\tgot := ${2:Slugify}(\"Hello World!\")",
			"\tassert${1:EqualString}(t, got, \"hello-world\")",
			"\t$0",
			"}"
		],
		"description": "Reusable assertion helper with t.Helper for clear failures"
	}
}
