{
	"Function": {
		"prefix": "fn",
		"body": [
			"func ${1:name}(${2:args}) ${3:error} {",
			"    $0",
			"}"
		],
		"description": "Function"
	},
	"Method": {
		"prefix": "method",
		"body": [
			"func (${1:r} ${2:Receiver}) ${3:Name}(${4:args}) ${5:error} {",
			"    $0",
			"}"
		],
		"description": "Method on receiver"
	},
	"Main": {
		"prefix": "main",
		"body": [
			"func main() {",
			"    $0",
			"}"
		],
		"description": "main function"
	},
	"Struct": {
		"prefix": "struct",
		"body": [
			"type ${1:Name} struct {",
			"    $0",
			"}"
		],
		"description": "Struct type"
	},
	"Interface": {
		"prefix": "interface",
		"body": [
			"type ${1:Name} interface {",
			"    $0",
			"}"
		],
		"description": "Interface type"
	},
	"Test Function": {
		"prefix": "test",
		"body": [
			"func Test${1:Name}(t *testing.T) {",
			"    $0",
			"}"
		],
		"description": "Test function"
	},
	"Error Check": {
		"prefix": "err",
		"body": [
			"if err != nil {",
			"    return ${1:err}",
			"}"
		],
		"description": "if err != nil"
	},
	"For Range": {
		"prefix": "range",
		"body": [
			"for ${1:i}, ${2:v} := range ${3:slice} {",
			"    $0",
			"}"
		],
		"description": "for range loop"
	},
	"Table-driven test": {
		"prefix": "tdt",
		"body": [
			"func Test_${1:Name}(t *testing.T) {",
			"\ttests := []struct {",
			"\t\tname string",
			"\t\ta    []int",
			"\t\tb    []int",
			"\t\twant []int",
			"\t}{",
			"\t\t{\"${2:unique lists}\", []int{1, 3, 5}, []int{2, 4, 6}, []int{1, 2, 3, 4, 5, 6}},",
			"\t}",
			"\tfor _, tt := range tests {",
			"\t\tt.Run(tt.name, func(t *testing.T) {",
			"\t\t\tgot := ${3:MergeSorted}(tt.a, tt.b)",
			"\t\t\tif !slices.Equal(got, tt.want) {",
			"\t\t\t\tt.Errorf(\"${3:MergeSorted}(%v, %v) = %v; want %v\", tt.a, tt.b, got, tt.want)",
			"\t\t\t}",
			"\t\t\t$0",
			"\t\t})",
			"\t}",
			"}"
		],
		"description": "Table-driven test (a/b/want, slices.Equal); needs testing + slices"
	}
}
