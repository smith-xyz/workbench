{
	"Concurrency: Worker Pool": {
		"prefix": "cc-worker-pool",
		"body": [
			"func ${1:runWorkerPool}(ctx context.Context, jobs <-chan ${2:Job}, workerCount int) error {",
			"\tvar wg sync.WaitGroup",
			"\twg.Add(workerCount)",
			"",
			"\tfor i := 0; i < workerCount; i++ {",
			"\t\tgo func() {",
			"\t\t\tdefer wg.Done()",
			"\t\t\tfor job := range jobs {",
			"\t\t\t\tif err := ${3:processJob}(ctx, job); err != nil {",
			"\t\t\t\t\treturn",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t}()",
			"\t}",
			"",
			"\twg.Wait()",
			"\treturn nil",
			"}",
			"$0"
		],
		"description": "Fixed pool of goroutines draining a job channel"
	},
	"Concurrency: Mutex": {
		"prefix": "cc-mutex",
		"body": [
			"type ${1:Counter} struct {",
			"\tmu    sync.Mutex",
			"\tvalue int",
			"}",
			"",
			"func (c *${1:Counter}) Inc() {",
			"\tc.mu.Lock()",
			"\tdefer c.mu.Unlock()",
			"\tc.value++",
			"}",
			"",
			"func (c *${1:Counter}) Value() int {",
			"\tc.mu.Lock()",
			"\tdefer c.mu.Unlock()",
			"\treturn c.value",
			"}",
			"$0"
		],
		"description": "Mutex-guarded shared state with lock/defer unlock"
	},
	"Concurrency: Channel": {
		"prefix": "cc-channel",
		"body": [
			"func ${1:runProducerConsumer}(ctx context.Context) error {",
			"\tjobs := make(chan ${2:int}, ${3:10})",
			"\tresults := make(chan ${2:int}, ${3:10})",
			"",
			"\tgo func() {",
			"\t\tdefer close(jobs)",
			"\t\tfor i := 0; i < ${4:100}; i++ {",
			"\t\t\tselect {",
			"\t\t\tcase <-ctx.Done():",
			"\t\t\t\treturn",
			"\t\t\tcase jobs <- i:",
			"\t\t\t}",
			"\t\t}",
			"\t}()",
			"",
			"\tgo func() {",
			"\t\tdefer close(results)",
			"\t\tfor job := range jobs {",
			"\t\t\tresults <- job * 2",
			"\t\t}",
			"\t}()",
			"",
			"\tfor result := range results {",
			"\t\t_ = result",
			"\t}",
			"\treturn ctx.Err()",
			"}",
			"$0"
		],
		"description": "Producer and consumer linked by buffered channels"
	},
	"Concurrency: Rate Limiter": {
		"prefix": "cc-rate-limiter",
		"body": [
			"type ${1:tokenBucket} struct {",
			"\ttokens   chan struct{}",
			"\tinterval time.Duration",
			"}",
			"",
			"func new${1:TokenBucket}(rate int, burst int) *${1:tokenBucket} {",
			"\ttb := &${1:tokenBucket}{",
			"\t\ttokens:   make(chan struct{}, burst),",
			"\t\tinterval: time.Second / time.Duration(rate),",
			"\t}",
			"\tfor i := 0; i < burst; i++ {",
			"\t\ttb.tokens <- struct{}{}",
			"\t}",
			"\tgo func() {",
			"\t\tticker := time.NewTicker(tb.interval)",
			"\t\tdefer ticker.Stop()",
			"\t\tfor range ticker.C {",
			"\t\t\tselect {",
			"\t\t\tcase tb.tokens <- struct{}{}:",
			"\t\t\tdefault:",
			"\t\t\t}",
			"\t\t}",
			"\t}()",
			"\treturn tb",
			"}",
			"",
			"func (tb *${1:tokenBucket}) Allow(ctx context.Context) error {",
			"\tselect {",
			"\tcase <-ctx.Done():",
			"\t\treturn ctx.Err()",
			"\tcase <-tb.tokens:",
			"\t\treturn nil",
			"\t}",
			"}",
			"$0"
		],
		"description": "Token-bucket rate limiter backed by a buffered channel"
	},
	"Concurrency: Fan-Out Fan-In": {
		"prefix": "cc-fan-out-fan-in",
		"body": [
			"func ${1:fanOutFanIn}(ctx context.Context, input <-chan ${2:int}, workers int) <-chan ${3:int} {",
			"\tout := make(chan ${3:int})",
			"\tvar wg sync.WaitGroup",
			"",
			"\tfor i := 0; i < workers; i++ {",
			"\t\twg.Add(1)",
			"\t\tgo func() {",
			"\t\t\tdefer wg.Done()",
			"\t\t\tfor item := range input {",
			"\t\t\t\tselect {",
			"\t\t\t\tcase <-ctx.Done():",
			"\t\t\t\t\treturn",
			"\t\t\t\tcase out <- ${4:transform}(item):",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t}()",
			"\t}",
			"",
			"\tgo func() {",
			"\t\twg.Wait()",
			"\t\tclose(out)",
			"\t}()",
			"",
			"\treturn out",
			"}",
			"$0"
		],
		"description": "Fan work out to worker goroutines and merge into one channel"
	},
	"Concurrency: Context Cancel": {
		"prefix": "cc-context-cancel",
		"body": [
			"func ${1:runWithCancel}(ctx context.Context) error {",
			"\tctx, cancel := context.WithCancel(ctx)",
			"\tdefer cancel()",
			"",
			"\tdone := make(chan error, 1)",
			"\tgo func() {",
			"\t\tdone <- ${2:longRunningWork}(ctx)",
			"\t}()",
			"",
			"\tselect {",
			"\tcase err := <-done:",
			"\t\treturn err",
			"\tcase <-ctx.Done():",
			"\t\tcancel()",
			"\t\treturn ctx.Err()",
			"\t}",
			"}",
			"$0"
		],
		"description": "Propagate cancellation via context.WithCancel and select"
	},
	"Concurrency: Async Stream": {
		"prefix": "cc-async-stream",
		"body": [
			"func ${1:streamItems}(ctx context.Context) <-chan ${2:Item} {",
			"\tch := make(chan ${2:Item})",
			"\tgo func() {",
			"\t\tdefer close(ch)",
			"\t\tfor i := 0; i < ${3:100}; i++ {",
			"\t\t\tselect {",
			"\t\t\tcase <-ctx.Done():",
			"\t\t\t\treturn",
			"\t\t\tcase ch <- ${2:Item}{ID: i}:",
			"\t\t\t}",
			"\t\t}",
			"\t}()",
			"\treturn ch",
			"}",
			"",
			"func ${4:consumeStream}(ctx context.Context) error {",
			"\tfor item := range ${1:streamItems}(ctx) {",
			"\t\t_ = item",
			"\t}",
			"\treturn ctx.Err()",
			"}",
			"$0"
		],
		"description": "Channel-backed async stream with producer goroutine and consumer loop"
	},
	"Concurrency: Semaphore": {
		"prefix": "cc-semaphore",
		"body": [
			"type ${1:semaphore} struct {",
			"\tslots chan struct{}",
			"}",
			"",
			"func new${1:Semaphore}(limit int) *${1:semaphore} {",
			"\treturn &${1:semaphore}{slots: make(chan struct{}, limit)}",
			"}",
			"",
			"func (s *${1:semaphore}) Acquire(ctx context.Context) error {",
			"\tselect {",
			"\tcase <-ctx.Done():",
			"\t\treturn ctx.Err()",
			"\tcase s.slots <- struct{}{}:",
			"\t\treturn nil",
			"\t}",
			"}",
			"",
			"func (s *${1:semaphore}) Release() {",
			"\t<-s.slots",
			"}",
			"$0"
		],
		"description": "Counting semaphore implemented with a buffered channel"
	}
}
