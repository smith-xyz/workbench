	"Algorithm: BFS Grid": {
		"prefix": "al-bfs-grid",
		"body": [
			"func bfs${1:Grid}(${1:grid} [][]int, sr, sc, tr, tc int) int {",
			"\trows, cols := len(${1:grid}), len(${1:grid}[0])",
			"\tdirs := [][2]int{{0, 1}, {0, -1}, {1, 0}, {-1, 0}}",
			"\tvisited := make(map[[2]int]bool)",
			"\ttype state struct{ r, c, dist int }",
			"\tq := []state{{sr, sc, 0}}",
			"\tvisited[[2]int{sr, sc}] = true",
			"\tfor len(q) > 0 {",
			"\t\tcur := q[0]",
			"\t\tq = q[1:]",
			"\t\tif cur.r == tr && cur.c == tc {",
			"\t\t\treturn cur.dist",
			"\t\t}",
			"\t\tfor _, d := range dirs {",
			"\t\t\tnr, nc := cur.r+d[0], cur.c+d[1]",
			"\t\t\tif nr < 0 || nr >= rows || nc < 0 || nc >= cols {",
			"\t\t\t\tcontinue",
			"\t\t\t}",
			"\t\t\tif visited[[2]int{nr, nc}] || ${1:grid}[nr][nc] == ${2:block} {",
			"\t\t\t\tcontinue",
			"\t\t\t}",
			"\t\t\tvisited[[2]int{nr, nc}] = true",
			"\t\t\tq = append(q, state{nr, nc, cur.dist + 1})",
			"\t\t}",
			"\t}",
			"\t$0",
			"\treturn -1",
			"}"
		],
		"description": "BFS shortest path on a 2D grid with visited tracking"
	},
