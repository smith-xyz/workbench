	"Algorithm: Topological Sort": {
		"prefix": "al-topological-sort",
		"body": [
			"func topoSort(n int, edges [][2]int) []int {",
			"\tadj := make([][]int, n)",
			"\tindeg := make([]int, n)",
			"\tfor _, e := range edges {",
			"\t\tadj[e[0]] = append(adj[e[0]], e[1])",
			"\t\tindeg[e[1]]++",
			"\t}",
			"\tq := make([]int, 0)",
			"\tfor i := 0; i < n; i++ {",
			"\t\tif indeg[i] == 0 {",
			"\t\t\tq = append(q, i)",
			"\t\t}",
			"\t}",
			"\torder := make([]int, 0, n)",
			"\tfor len(q) > 0 {",
			"\t\tu := q[0]",
			"\t\tq = q[1:]",
			"\t\torder = append(order, u)",
			"\t\tfor _, v := range adj[u] {",
			"\t\t\tindeg[v]--",
			"\t\t\tif indeg[v] == 0 {",
			"\t\t\t\tq = append(q, v)",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"\t$0",
			"\tif len(order) != n {",
			"\t\treturn nil",
			"\t}",
			"\treturn order",
			"}"
		],
		"description": "Topological sort via Kahn's BFS-based algorithm"
	},
	"Algorithm: Union Find": {
		"prefix": "al-union-find",
		"body": [
			"type UnionFind struct {",
			"\tparent []int",
			"\trank   []int",
			"}",
			"",
			"func NewUnionFind(n int) *UnionFind {",
			"\tuf := &UnionFind{",
			"\t\tparent: make([]int, n),",
			"\t\trank:   make([]int, n),",
			"\t}",
			"\tfor i := range uf.parent {",
			"\t\tuf.parent[i] = i",
			"\t}",
			"\treturn uf",
			"}",
			"",
			"func (uf *UnionFind) Find(x int) int {",
			"\tif uf.parent[x] != x {",
			"\t\tuf.parent[x] = uf.Find(uf.parent[x])",
			"\t}",
			"\treturn uf.parent[x]",
			"}",
			"",
			"func (uf *UnionFind) Union(a, b int) bool {",
			"\tra, rb := uf.Find(a), uf.Find(b)",
			"\tif ra == rb {",
			"\t\treturn false",
			"\t}",
			"\tif uf.rank[ra] < uf.rank[rb] {",
			"\t\tra, rb = rb, ra",
			"\t}",
			"\tuf.parent[rb] = ra",
			"\tif uf.rank[ra] == uf.rank[rb] {",
			"\t\tuf.rank[ra]++",
			"\t}",
			"\treturn true",
			"}",
			"",
			"uf := NewUnionFind(${1:n})",
			"$0"
		],
		"description": "Disjoint set union with path compression and union by rank"
	},
