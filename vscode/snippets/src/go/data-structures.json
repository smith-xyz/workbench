{
	"Data Structure: Stack": {
		"prefix": "ds-stack",
		"body": [
			"type ${1:Stack}[T any] struct {",
			"\titems []T",
			"}",
			"",
			"func New${1:Stack}[T any]() *${1:Stack}[T] {",
			"\treturn &${1:Stack}[T]{}",
			"}",
			"",
			"func (s *${1:Stack}[T]) Push(v T) {",
			"\ts.items = append(s.items, v)",
			"}",
			"",
			"func (s *${1:Stack}[T]) Pop() (T, bool) {",
			"\tif len(s.items) == 0 {",
			"\t\tvar zero T",
			"\t\treturn zero, false",
			"\t}",
			"\tv := s.items[len(s.items)-1]",
			"\ts.items = s.items[:len(s.items)-1]",
			"\treturn v, true",
			"}",
			"",
			"func (s *${1:Stack}[T]) Peek() (T, bool) {",
			"\tif len(s.items) == 0 {",
			"\t\tvar zero T",
			"\t\treturn zero, false",
			"\t}",
			"\treturn s.items[len(s.items)-1], true",
			"}",
			"$0"
		],
		"description": "Generic stack with push, pop, and peek."
	},
	"Data Structure: Queue": {
