			"func New${1:Queue}[T any]() *${1:Queue}[T] {",
			"\treturn &${1:Queue}[T]{}",
			"}",
			"",
			"func (q *${1:Queue}[T]) Enqueue(v T) {",
			"\tq.items = append(q.items, v)",
			"}",
			"",
			"func (q *${1:Queue}[T]) Dequeue() (T, bool) {",
			"\tif len(q.items) == 0 {",
			"\t\tvar zero T",
