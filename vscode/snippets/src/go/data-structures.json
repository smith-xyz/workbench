	"Data Structure: Priority Queue": {
		"prefix": "ds-priority-queue",
		"body": [
			"import \"container/heap\"",
			"",
			"type ${1:PQItem}[T any] struct {",
			"\tValue    T",
			"\tPriority int",
			"\tindex    int",
			"}",
			"",
			"type ${2:PriorityQueue}[T any] struct {",
			"\titems []*${1:PQItem}[T]",
			"}",
			"",
			"func (pq *${2:PriorityQueue}[T]) Len() int { return len(pq.items) }",
			"func (pq *${2:PriorityQueue}[T]) Less(i, j int) bool {",
			"\treturn pq.items[i].Priority < pq.items[j].Priority",
			"}",
			"func (pq *${2:PriorityQueue}[T]) Swap(i, j int) {",
			"\tpq.items[i], pq.items[j] = pq.items[j], pq.items[i]",
			"\tpq.items[i].index, pq.items[j].index = i, j",
			"}",
			"func (pq *${2:PriorityQueue}[T]) Push(x any) {",
			"\titem := x.(*${1:PQItem}[T])",
			"\titem.index = len(pq.items)",
			"\tpq.items = append(pq.items, item)",
			"}",
			"func (pq *${2:PriorityQueue}[T]) Pop() any {",
			"\tn := len(pq.items)",
			"\titem := pq.items[n-1]",
			"\tpq.items = pq.items[:n-1]",
			"\treturn item",
			"}",
			"",
			"func (pq *${2:PriorityQueue}[T]) Enqueue(value T, priority int) {",
			"\theap.Push(pq, &${1:PQItem}[T]{Value: value, Priority: priority})",
			"}",
			"",
			"func (pq *${2:PriorityQueue}[T]) Dequeue() (T, bool) {",
			"\tif pq.Len() == 0 {",
			"\t\tvar zero T",
			"\t\treturn zero, false",
			"\t}",
			"\titem := heap.Pop(pq).(*${1:PQItem}[T])",
			"\treturn item.Value, true",
			"}",
			"$0"
		],
		"description": "Min-heap priority queue using container/heap."
	},
	"Data Structure: Linked List": {
		"prefix": "ds-linked-list",
		"body": [
			"type ${1:Node}[T any] struct {",
			"\tVal  T",
			"\tNext *${1:Node}[T]",
			"}",
			"",
			"type ${2:LinkedList}[T any] struct {",
			"\thead *${1:Node}[T]",
			"}",
			"",
			"func New${2:LinkedList}[T any]() *${2:LinkedList}[T] {",
			"\treturn &${2:LinkedList}[T]{}",
			"}",
			"",
			"func (l *${2:LinkedList}[T]) Insert(v T) {",
			"\tl.head = &${1:Node}[T]{Val: v, Next: l.head}",
			"}",
			"",
			"func (l *${2:LinkedList}[T]) Delete(v T) bool {",
			"\tdummy := &${1:Node}[T]{Next: l.head}",
			"\tprev, cur := dummy, l.head",
			"\tfor cur != nil {",
			"\t\tif any(cur.Val) == any(v) {",
			"\t\t\tprev.Next = cur.Next",
			"\t\t\tl.head = dummy.Next",
			"\t\t\treturn true",
			"\t\t}",
			"\t\tprev, cur = cur, cur.Next",
			"\t}",
			"\treturn false",
			"}",
			"",
			"func (l *${2:LinkedList}[T]) Traverse(fn func(T)) {",
			"\tfor cur := l.head; cur != nil; cur = cur.Next {",
			"\t\tfn(cur.Val)",
			"\t}",
			"}",
			"$0"
		],
		"description": "Singly linked list with insert, delete, and traverse."
	},
	"Data Structure: LRU Cache": {
		"prefix": "ds-lru-cache",
		"body": [
			"import \"container/list\"",
			"",
			"type ${1:lruEntry}[K comparable, V any] struct {",
			"\tkey   K",
			"\tvalue V",
			"}",
			"",
			"type ${2:LRUCache}[K comparable, V any] struct {",
			"\tcapacity int",
			"\tcache    map[K]*list.Element",
			"\tlist     *list.List",
			"}",
			"",
			"func New${2:LRUCache}[K comparable, V any](capacity int) *${2:LRUCache}[K, V] {",
			"\treturn &${2:LRUCache}[K, V]{",
			"\t\tcapacity: capacity,",
			"\t\tcache:    make(map[K]*list.Element),",
			"\t\tlist:     list.New(),",
			"\t}",
			"}",
			"",
			"func (c *${2:LRUCache}[K, V]) Get(key K) (V, bool) {",
			"\tif elem, ok := c.cache[key]; ok {",
			"\t\tc.list.MoveToFront(elem)",
			"\t\treturn elem.Value.(${1:lruEntry}[K, V]).value, true",
			"\t}",
			"\tvar zero V",
			"\treturn zero, false",
			"}",
			"",
			"func (c *${2:LRUCache}[K, V]) Put(key K, value V) {",
			"\tif elem, ok := c.cache[key]; ok {",
			"\t\tc.list.MoveToFront(elem)",
			"\t\telem.Value = ${1:lruEntry}[K, V]{key: key, value: value}",
			"\t\treturn",
			"\t}",
			"\telem := c.list.PushFront(${1:lruEntry}[K, V]{key: key, value: value})",
			"\tc.cache[key] = elem",
			"\tif c.list.Len() > c.capacity {",
			"\t\tback := c.list.Back()",
			"\t\tc.list.Remove(back)",
			"\t\tdelete(c.cache, back.Value.(${1:lruEntry}[K, V]).key)",
			"\t}",
			"}",
			"$0"
		],
		"description": "LRU cache with map and doubly-linked list eviction."
	},
	"Data Structure: Ring Buffer": {
		"prefix": "ds-ring-buffer",
		"body": [
			"type ${1:RingBuffer}[T any] struct {",
			"\tbuf  []T",
			"\thead int",
			"\ttail int",
			"\tsize int",
			"}",
			"",
			"func New${1:RingBuffer}[T any](capacity int) *${1:RingBuffer}[T] {",
			"\treturn &${1:RingBuffer}[T]{buf: make([]T, capacity)}",
			"}",
			"",
			"func (r *${1:RingBuffer}[T]) Write(v T) bool {",
			"\tif r.size == len(r.buf) {",
			"\t\treturn false",
			"\t}",
			"\tr.buf[r.tail] = v",
			"\tr.tail = (r.tail + 1) % len(r.buf)",
			"\tr.size++",
			"\treturn true",
			"}",
			"",
			"func (r *${1:RingBuffer}[T]) Read() (T, bool) {",
			"\tif r.size == 0 {",
			"\t\tvar zero T",
			"\t\treturn zero, false",
			"\t}",
			"\tv := r.buf[r.head]",
			"\tr.head = (r.head + 1) % len(r.buf)",
			"\tr.size--",
			"\treturn v, true",
			"}",
			"$0"
		],
		"description": "Fixed-size circular buffer with read and write."
	},
	"Data Structure: Trie": {
		"prefix": "ds-trie",
		"body": [
			"type ${1:Trie} struct {",
			"\tchildren map[rune]*${1:Trie}",
			"\tisEnd    bool",
			"}",
			"",
			"func New${1:Trie}() *${1:Trie} {",
			"\treturn &${1:Trie}{children: make(map[rune]*${1:Trie})}",
			"}",
			"",
			"func (t *${1:Trie}) Insert(word string) {",
			"\tnode := t",
			"\tfor _, ch := range word {",
			"\t\tif node.children[ch] == nil {",
			"\t\t\tnode.children[ch] = &${1:Trie}{children: make(map[rune]*${1:Trie})}",
			"\t\t}",
			"\t\tnode = node.children[ch]",
			"\t}",
			"\tnode.isEnd = true",
			"}",
			"",
			"func (t *${1:Trie}) Search(word string) bool {",
			"\tnode, ok := t.find(word)",
			"\treturn ok && node.isEnd",
			"}",
			"",
			"func (t *${1:Trie}) StartsWith(prefix string) bool {",
			"\t_, ok := t.find(prefix)",
			"\treturn ok",
			"}",
			"",
			"func (t *${1:Trie}) find(s string) (*${1:Trie}, bool) {",
			"\tnode := t",
			"\tfor _, ch := range s {",
			"\t\tchild, ok := node.children[ch]",
			"\t\tif !ok {",
			"\t\t\treturn nil, false",
			"\t\t}",
			"\t\tnode = child",
			"\t}",
			"\treturn node, true",
			"}",
			"$0"
		],
		"description": "Prefix trie with insert, search, and starts-with."
	},
	"Data Structure: Graph": {
		"prefix": "ds-graph",
		"body": [
			"type ${1:Graph}[T comparable] struct {",
			"\tadj map[T][]T",
			"}",
			"",
			"func New${1:Graph}[T comparable]() *${1:Graph}[T] {",
			"\treturn &${1:Graph}[T]{adj: make(map[T][]T)}",
			"}",
			"",
			"func (g *${1:Graph}[T]) AddEdge(u, v T) {",
			"\tg.adj[u] = append(g.adj[u], v)",
			"}",
			"",
			"func (g *${1:Graph}[T]) BFS(start T, visit func(T)) {",
			"\tseen := map[T]bool{start: true}",
			"\tqueue := []T{start}",
			"\tfor len(queue) > 0 {",
			"\t\tu := queue[0]",
			"\t\tqueue = queue[1:]",
			"\t\tvisit(u)",
			"\t\tfor _, v := range g.adj[u] {",
			"\t\t\tif !seen[v] {",
			"\t\t\t\tseen[v] = true",
			"\t\t\t\tqueue = append(queue, v)",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"}",
			"",
			"func (g *${1:Graph}[T]) DFS(start T, visit func(T)) {",
			"\tseen := make(map[T]bool)",
			"\tvar dfs func(T)",
			"\tdfs = func(u T) {",
			"\t\tseen[u] = true",
			"\t\tvisit(u)",
			"\t\tfor _, v := range g.adj[u] {",
			"\t\t\tif !seen[v] {",
			"\t\t\t\tdfs(v)",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"\tdfs(start)",
			"}",
			"$0"
		],
		"description": "Adjacency list graph with add-edge, BFS, and DFS."
	}
}
