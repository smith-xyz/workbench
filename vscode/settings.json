{
  "workbench.colorTheme": "Atomic Dark",
  "workbench.iconTheme": "file-icons",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.scrollback": 10000,
  "window.commandCenter": true,

  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.inlineSuggest.enabled": false,
  "editor.inlineSuggest.edits.allowCodeShifting": "never",
  "editor.inlineSuggest.edits.renderSideBySide": "never",
  "diffEditor.ignoreTrimWhitespace": false,

  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "always",

  "extensions.ignoreRecommendations": true,
  "makefile.configureOnOpen": true,

  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
  },
  "[python]": {
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.defaultColorDecorators": "never",
    "editor.formatOnType": true,
    "editor.wordBasedSuggestions": "off",
  },

  "python.defaultInterpreterPath": "python3",

  "go.toolsManagement.autoUpdate": true,
  "go.lintTool": "golangci-lint",
  "go.formatTool": "custom",
  "go.alternateTools": {
    "customFormatter": "golangci-lint",
  },
  "go.formatFlags": ["fmt", "--stdin"],

  "prettier.proseWrap": "preserve",
  "prettier.printWidth": 80,
  "prettier.tabWidth": 2,

  "javascript.updateImportsOnFileMove.enabled": "always",

  "editor.codeActionsOnSave": {
    "source.fixAll.shellcheck": "explicit",
  },

  "markdown-mermaid.darkModeTheme": "neutral",
  "markdown-mermaid.lightModeTheme": "neutral",

  "window.autoDetectColorScheme": false,
  "redhat.telemetry.enabled": false,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:claude-sonnet-4.6",
}
